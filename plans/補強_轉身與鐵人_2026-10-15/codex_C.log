  </header>

  <section class="bs-resume" data-resume hidden aria-label="接著讀"></section>
  {{- $starts := slice }}
  {{- range $lib.series }}
    {{- if eq .id "mnfl" }}{{ with index .entries 0 }}{{ $starts = $starts | append (dict "k" "3 分鐘" "t" (printf "一個學習技法：%s" .title) "d" .desc "p" .path "g" "learning") }}{{ end }}{{ end }}
    {{- if eq .id "kinesiology" }}{{ with index .chapters 0 }}{{ $starts = $starts | append (dict "k" "5 分鐘" "t" (printf "肌動學第 1 章：%s（先讀第一節就好）" .title) "d" .desc "p" .path "g" "strength") }}{{ end }}{{ end }}
    {{- if eq .id "cscs" }}{{ $starts = $starts | append (dict "k" "5 分鐘" "t" "CSCS 隨機五題" "d" "隨機抽一章、再抽 5 題，答錯的會連回課本那一條" "p" "library/essentials-of-strength-training/quiz/?ch=random&n=5" "g" "strength") }}{{ end }}
    {{- if eq .id "temperament" }}{{ with index .entries 0 }}{{ $starts = $starts | append (dict "k" "2 分鐘" "t" (printf "一個氣質維度：%s" .title) "d" .desc "p" .path "g" "temperament") }}{{ end }}{{ end }}
  {{- end }}
  {{- with $starts }}
  {{- $st := resources.FromString "starters.json" (jsonify hugo.Data.starters) | fingerprint }}
  <section class="bs-start" data-starter data-src="{{ $st.RelPermalink }}" aria-labelledby="bs-start-h">
    <h2 id="bs-start-h">不知道從哪開始？挑一個短的</h2>
    <div class="bs-start-list">
    {{- range . }}
      <a class="bs-start-i series-{{ .g }}" href="{{ relURL .p }}"><span class="bs-start-k">{{ .k }}</span><span class="bs-start-t">{{ .t }}</span><span class="bs-start-d">{{ .d }}</span></a>
    {{- end }}
    </div>
    <p class="bs-start-foot"><button type="button" class="bs-shuffle" data-shuffle hidden>換一組</button><span class="muted" data-starter-note></span></p>
  </section>
  {{- end }}

  <section class="bs-vortex series-vortex" aria-labelledby="bs-v">
    <p class="kicker">主要研究</p>
    <h2 id="bs-v" class="bs-v-title"><a href="{{ relURL "vortex/" }}">Vortex 水感</a></h2>
    <p class="bs-v-lead">技術是水感的輸出，不是要照抄的動作。六種泳式拆成一個個動作，每個動作都接到怎麼練、常見的錯誤想法、背後的物理，以及練不起來時該看哪裡。</p>
    <p class="bs-stats">
      <span><b>{{ index $vc "move" }}</b> 個動作</span>
      <span><b>{{ index $vc "drill" }}</b> 個練習</span>
      <span><b>{{ index $vc "error" }}</b> 條教學誤區</span>
      <span><b>{{ index $vc "tech" }}</b> 條技術分析</span>
      <span><b>{{ lang.FormatNumber 0 $vl }}</b> 條知識連結</span>
    </p>
    <nav class="bs-v-strokes" aria-label="六種泳式">
      {{- range slice "free" "back" "breast" "fly" "udk" "starts-turns" }}
      <a href="{{ relURL (printf "vortex/%s/" .) }}">{{ (index $v.strokes .).name_zh }}</a>
      {{- end }}
    </nav>
    <p><a class="bs-go" href="{{ relURL "vortex/" }}">進入 Vortex 水感 →</a></p>
  </section>

  <section class="bs-shelf" aria-labelledby="bs-shelf-h">
    <h2 id="bs-shelf-h">書房</h2>
    <p class="bs-shelf-lead">一本書一個系列，各自有完整目錄；書裡的知識點彼此連結，相近的書之間也可以對照著讀。</p>
    {{- $last := "" }}
    {{- range $i, $s := $lib.series }}
      {{- if ne $s.group_name $last }}
        {{- if ne $i 0 }}</div>{{ end }}
    <h3 class="bs-group series-{{ $s.group }}">{{ $s.group_name }}</h3>
