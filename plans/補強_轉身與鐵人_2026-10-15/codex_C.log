inspiration","rel":"機制","why":"它說橫膈吸氣下降，這裡補充橫膈同時參與腹內壓與軀幹穩定"},{"to":"nordin.ch10.abdominal-pressure","book":"生物力學","title":"生物力學第10章 · 腹內壓可能提供伸展作用，但也有建立壓力的成本","path":"library/basic-biomechanics/ch10/#abdominal-pressure","rel":"同一概念","why":"兩段皆論腹內壓產生需肌力與對腰椎伸展的協助及限制"},{"to":"ch02.joint-biomechanics.i03","book":"CSCS","title":"CSCS第2章 · 關節生物力學 Joint Biomechanics · 腹內壓 & 腰帶","path":"library/essentials-of-strength-training/ch02/#ch02.joint-biomechanics.i03","rel":"應用","why":"這裡說明腹內壓在通氣與軀幹穩定間的協調，補充它對腹內壓作為脊椎支撐的訓練應用"}],"femoroacetabular-impingement":[{"to":"neumann.ch12.impingement","book":"肌動學","title":"肌動學第12章 · 股骨髖臼夾擠，要分形態、接觸與症狀","path":"library/kinesiology/ch12/#impingement","rel":"同一概念","why":"兩段皆談 FAI 的凸輪與鉗夾形態、空間淨空與盂唇影響"}],"neumann.ch12.impingement":[{"to":"femoroacetabular-impingement","book":"Vortex","title":"Vortex · 股骨髖臼撞擊（FAI）","path":"vortex/injuries/femoroacetabular-impingement/","rel":"同一概念","why":"兩段皆談 FAI 的凸輪與鉗夾形態、空間淨空與盂唇影響"},{"to":"nordin.ch16.reconstructed-geometry","book":"生物力學","title":"生物力學第16章 · 重建幾何同時改變外力矩與肌肉的力臂","path":"library/basic-biomechanics/ch16/#reconstructed-geometry","rel":"同一概念","why":"兩邊都談髖關節幾何改變時外力臂與肌力臂的重新分配"}],"neumann.ch15.hip-trunk-deviations":[{"to":"nordin.ch17.trendelenburg","book":"生物力學","title":"生物力學第17章 · 骨盆下沉與向支撐側傾身需要分開辨認","path":"library/basic-biomechanics/ch17/#trendelenburg","rel":"同一概念","why":"兩段皆區分對側骨盆下沉與軀幹向支撐側傾斜的代償"},{"to":"nordin.ch08.trunk-lean","book":"生物力學","title":"生物力學第8章 · 軀幹側傾可以減少需求，也可能掩蓋能力不足","path":"library/basic-biomechanics/ch08/#trunk-lean","rel":"同一概念","why":"這裡描述骨盆與軀幹傾斜代償，它以力臂模型量化其減載機制"},{"to":"movement.action.hip.abduction","book":"Vortex","title":"Vortex 動作圖譜 · 髖外展","path":"vortex/movement/#movement.action.hip.abduction","rel":"同一概念","why":"這裡詳述髖外展肌無力時骨盆下沉與軀幹代償的具體方向"},{"to":"movement.muscle.hip-abductors","book":"Vortex","title":"Vortex 動作圖譜 · 髖外展肌群","path":"vortex/movement/#movement.muscle.hip-abductors","rel":"應用","why":"它列出髖外展肌群組成，這裡說明外展肌無力時代償動作與骨盆軀幹方向"}],"neumann.ch06.radius-ulna":[{"to":"nordin.ch13.muscular-action","book":"生物力學","title":"生物力學第13章 · 肌肉輸出依姿勢與任務而變","path":"library/basic-biomechanics/ch13/#muscular-action","rel":"機制","why":"這裡描述肘關節骨結構與肌附著，它說明這些附著如何決定肌肉在屈肘與旋前旋後的分工"},{"to":"movement.action.elbow.extension","book":"Vortex","title":"Vortex 動作圖譜 · 肘伸展","path":"vortex/movement/#movement.action.elbow.extension","rel":"機制","why":"這裡解釋肘關節骨形與肌肉附著，補充它肘伸展動作定義的解剖基礎"},{"to":"nordin.ch13.bony-fit","book":"生物力學","title":"生物力學第13章 · 骨性接觸提供一部分穩定","path":"library/basic-biomechanics/ch13/#bony-fit","rel":"同一概念","why":"兩段皆談尺骨滑車切跡與橈骨頭的骨性吻合與穩定"},{"to":"nordin.ch13.elbow-kinematics","book":"生物力學","title":"生物力學第13章 · 肘是近似鉸鏈，轉軸仍會小幅改變","path":"library/basic-biomechanics/ch13/#elbow-kinematics","rel":"同一概念","why":"這裡描述肘關節解剖構造，它量化其轉軸並非完全固定鉸鏈"},{"to":"movement.muscle.forearm-supinators","book":"Vortex","title":"Vortex 動作圖譜 · 前臂旋後肌群","path":"vortex/movement/#movement.muscle.forearm-supinators","rel":"同一概念","why":"它講前臂旋後肌群，這裡講橈尺關節骨幾何如何支援旋後轉動"}],"neumann.ch15.hip-extensor-emg":[{"to":"nordin.ch17.hip-emg","book":"生物力學","title":"生物力學第17章 · 髖部肌群的活化在站立初期與擺盪前期各有重心","path":"library/basic-biomechanics/ch17/#hip-emg","rel":"同一概念","why":"兩段皆述臀大肌與臀中肌在承重與擺盪期的活化時序"},{"to":"nordin.ch10.lumbopelvic-motion","book":"生物力學","title":"生物力學第10章 · 腰椎與骨盆共同完成前彎，節律並非固定兩段","path":"library/basic-biomechanics/ch10/#lumbopelvic-motion","rel":"同一概念","why":"這裡描述臀大肌提前活化與步態角色，它給腰骨盆節律與伸髖協調的對照"},{"to":"movement.muscle.hip-extensors","book":"Vortex","title":"Vortex 動作圖譜 · 髖伸肌群","path":"vortex/movement/#movement.muscle.hip-extensors","rel":"應用","why":"這裡將臀大肌活化時序連結到步態承重控制應用"}],"nordin.ch17.hip-emg":[{"to":"movement.muscle.hip-flexors","book":"Vortex","title":"Vortex 動作圖譜 · 髖屈肌群","path":"vortex/movement/#movement.muscle.hip-flexors","rel":"機制","why":"這裡提供髖部肌群在步態各期的活化時序與分工，補充它對髖屈肌群肌肉能力的描述"},{"to":"neumann.ch15.hip-extensor-emg","book":"肌動學","title":"肌動學第15章 · 髖伸肌群：臀大肌與腿後肌群","path":"library/kinesiology/ch15/#hip-extensor-emg","rel":"同一概念","why":"兩段皆述臀大肌與臀中肌在承重與擺盪期的活化時序"},{"to":"neumann.ch16.hip-abductors","book":"肌動學","title":"肌動學第16章 · 髖外展肌在單腳支持時調節骨盆與股骨","path":"library/kinesiology/ch16/#hip-abductors","rel":"同一概念","why":"兩邊都講站立初期臀大肌與臀中肌的活化時序與髖穩定功能"},{"to":"neumann.ch16.swing-muscles","book":"肌動學","title":"肌動學第16章 · 髖屈肌與腿後肌群讓擺盪有加速也有減速","path":"library/kinesiology/ch16/#swing-muscles","rel":"同一概念","why":"它談擺盪期髖屈肌與腿後肌的角色，這裡補上站立期臀肌活化的時間與力矩"},{"to":"neumann.ch15.hip-sagittal-torque","book":"肌動學","title":"肌動學第15章 · 矢狀面髖力矩的三段切換","path":"library/kinesiology/ch15/#hip-sagittal-torque","rel":"同一概念","why":"它講矢狀面髖力矩三段切換，這裡講站立期與擺盪期髖部肌群活化時序"},{"to":"neumann.ch12.hip-abductors","book":"肌動學","title":"肌動學第12章 · 臀中肌、臀小肌與闊筋膜張肌共同控制外展","path":"library/kinesiology/ch12/#hip-abductors","rel":"應用","why":"它列髖外展肌群，這裡補充其在步態中的活化分工"},{"to":"movement.muscle.hip-abductors","book":"Vortex","title":"Vortex 動作圖譜 · 髖外展肌群","path":"vortex/movement/#movement.muscle.hip-abductors","rel":"應用","why":"它列出髖外展肌群組成，這裡詳述其在步態站立期與擺盪前期的活化時序與穩定任務"},{"to":"neumann.ch16.trunk-hip-muscles","book":"肌動學","title":"肌動學第16章 · 軀幹肌與臀大肌在接觸前後承接身體","path":"library/kinesiology/ch16/#trunk-hip-muscles","rel":"應用","why":"兩邊都談臀大肌在承重早期的活化時序與功能"},{"to":"movement.muscle.hip-extensors","book":"Vortex","title":"Vortex 動作圖譜 · 髖伸肌群","path":"vortex/movement/#movement.muscle.hip-extensors","rel":"應用","why":"它列出髖伸肌群組成，這裡詳述臀大肌等在步態站立與擺盪期的活化時序"}],"neumann.ch12.static-model":[{"to":"nordin.ch08.stance","book":"生物力學","title":"生物力學第8章 · 雙腳與單腳站立，需要不同的平衡","path":"library/basic-biomechanics/ch08/#stance","rel":"同一概念","why":"兩段以同 W=720 N 模型比較單腳與雙腳站立的髖反力"},{"to":"nordin.ch08.muscle-reaction","book":"生物力學","title":"生物力學第8章 · 肌肉穩定身體，也參與關節內負荷","path":"library/basic-biomechanics/ch08/#muscle-reaction","rel":"同一概念","why":"兩邊用同樣參數算單腳承重髖反力，是同一範例"},{"to":"nordin.ch09.tiptoe-experiment","book":"生物力學","title":"生物力學第9章 · 改變前足力臂，體重不變也會增加內部負荷","path":"library/basic-biomechanics/ch09/#tiptoe-experiment","rel":"同一概念","why":"兩邊都以力矩平衡示範肌力與關節反力的計算，這裡在髖它在踝"},{"to":"nordin.ch16.abductor-levers","book":"生物力學","title":"生物力學第16章 · 外展肌力臂變短與身體側傾，改的是不同邊","path":"library/basic-biomechanics/ch16/#abductor-levers","rel":"同一概念","why":"兩邊都以外展肌力臂縮短為例算單腳承重的力矩變化"},{"to":"nordin.ch01.elbow-example","book":"生物力學","title":"生物力學第1章 · 編者算例：很小的力臂需要很大的肌肉力","path":"library/basic-biomechanics/ch01/#elbow-example","rel":"同一概念","why":"兩邊都是力矩平衡算例，展示小力臂對肌肉力的放大"},{"to":"nordin.ch14.wrist-load-model","book":"生物力學","title":"生物力學第14章 · 腕部承重算例：小力臂讓肌肉力高於手持重量","path":"library/basic-biomechanics/ch14/#wrist-load-model","rel":"同一概念","why":"兩邊都是單關節靜力矩平衡算例，這裡髖外展肌，它腕屈肌，皆展示小力臂導致肌肉力遠大於負荷"},{"to":"nordin.ch08.lever-ratio","book":"生物力學","title":"生物力學第8章 · 力臂比說明趨勢，不是一個最佳人體比例","path":"library/basic-biomechanics/ch08/#lever-ratio","rel":"應用","why":"這裡用數值算例示範單腳承重力矩，它用力臂比公式系統化呈現肌力與反力趨勢"},{"to":"nordin.ch07.moment-balance","book":"生物力學","title":"生物力學第7章 · 力矩平衡能先求出模型中的肌腱拉力","path":"library/basic-biomechanics/ch07/#moment-balance","rel":"應用","why":"兩節皆以力矩平衡先求肌腱力的計算範例，可對照印證"}],"nordin.ch08.stance":[{"to":"neumann.ch12.joint-load","book":"肌動學","title":"肌動學第12章 · 關節負荷，還包含維持平衡的肌肉力量","path":"library/kinesiology/ch12/#joint-load","rel":"機制","why":"兩邊都用單腳模型分析髖受力，這裡提供量化反力計算"},{"to":"neumann.ch12.static-model","book":"肌動學","title":"肌動學第12章 · 一個可重算的單腳承重例子","path":"library/kinesiology/ch12/#static-model","rel":"同一概念","why":"兩段以同 W=720 N 模型比較單腳與雙腳站立的髖反力"},{"to":"neumann.ch12.hip-balance","book":"肌動學","title":"肌動學第12章 · 前傾與單腳承重，需要不同方向的平衡","path":"library/kinesiology/ch12/#hip-balance","rel":"同一概念","why":"兩邊都談單腳承重骨盆下降與外展肌力矩，這裡補雙腳對稱模型的簡化力值"}],"ch20.special-issues.i04":[{"to":"periodization.taper.type.step","book":"Vortex","title":"Vortex 週期化 · 階梯式減量","path":"vortex/periodization/#periodization.taper.type.step","rel":"應用","why":"它為這裡三種減量模型之一的階梯式減量提供游泳訓練應用"},{"to":"periodization.taper.swim","book":"Vortex","title":"Vortex 週期化 · 游泳減量應用","path":"vortex/periodization/#periodization.taper.swim","rel":"應用","why":"它提供游泳減量期的具體參數，實例化這裡三種減量模型"},{"to":"periodization.taper.duration","book":"Vortex","title":"Vortex 週期化 · 減量時長","path":"vortex/periodization/#periodization.taper.duration","rel":"應用","why":"這裡講三種減量模型，它給出實際天數指引，具體互補"},{"to":"periodization.taper.definition","book":"Vortex","title":"Vortex 週期化 · 減量定義","path":"vortex/periodization/#periodization.taper.definition","rel":"應用","why":"這裡區分三種減量訓練模型，它給出游泳減量的實務定義"},{"to":"periodization.taper.volume","book":"Vortex","title":"Vortex 週期化 · 訓練量","path":"vortex/periodization/#periodization.taper.volume","rel":"應用","why":"CSCS三種減量模型對應Vortex訓練量降幅的週期化操作"}],"periodization.taper.type.step":[{"to":"ch20.special-issues.i04","book":"CSCS","title":"CSCS第20章 · 特殊訓練議題 Special Issues · 三種減量訓練模型如何區分？","path":"library/essentials-of-strength-training/ch20/#ch20.special-issues.i04","rel":"應用","why":"這裡為它三種減量模型之一的階梯式減量提供游泳訓練應用"}],"neumann.ch15.swing":[{"to":"nordin.ch17.knee-emg","book":"生物力學","title":"生物力學第17章 · 膝部股四頭肌與腿後肌群的活化時序決定支撐穩定","path":"library/basic-biomechanics/ch17/#knee-emg","rel":"機制","why":"這裡講擺盪減速的肌肉活化，它講支撐期股四頭肌與腿後肌群的活化時序，兩者互補步態肌肉控制"},{"to":"nordin.ch17.ankle-emg","book":"生物力學","title":"生物力學第17章 · 踝足肌群的活化分布於整個站立與擺盪期","path":"library/basic-biomechanics/ch17/#ankle-emg","rel":"同一概念","why":"兩段皆談脛前肌在擺盪背屈與承重減速的角色"},{"to":"nordin.ch17.gait-phases","book":"生物力學","title":"生物力學第17章 · 接觸與離地事件界定站立、擺盪分段","path":"library/basic-biomechanics/ch17/#gait-phases","rel":"同一概念","why":"它以 10–12%、30–50%、50–60% 等分期對應這裡擺盪減速與承重準備的時序"},{"to":"nordin.ch17.ankle-kinematics","book":"生物力學","title":"生物力學第17章 · 踝關節在承重與推進中先蹠屈再背屈再蹠屈","path":"library/basic-biomechanics/ch17/#ankle-kinematics","rel":"同一概念","why":"兩邊都講擺盪期與承重期間踝背屈／蹠屈的時序變化"}],"neumann.ch09.coupled-motion":[{"to":"nordin.ch11.six-directions","book":"生物力學","title":"生物力學第11章 · 三維運動包含旋轉，也包含平移","path":"library/basic-biomechanics/ch11/#six-directions","rel":"同一概念","why":"兩段皆談耦合運動與頸椎側彎伴隨旋轉的例子"}],"nordin.ch11.six-directions":[{"to":"neumann.ch09.coupled-motion","book":"肌動學","title":"肌動學第9章 · 耦合要逐區理解，不能只背一條方向規則","path":"library/kinesiology/ch09/#coupled-motion","rel":"同一概念","why":"兩段皆談耦合運動與頸椎側彎伴隨旋轉的例子"},{"to":"neumann.ch09.motion-terms","book":"肌動學","title":"肌動學第9章 · 說向左旋轉時，是看椎體前方","path":"library/kinesiology/ch09/#motion-terms","rel":"同一概念","why":"兩邊都強調三維運動的旋轉軸、參照骨與耦合運動須明確標示"},{"to":"neumann.ch09.scoliosis","book":"肌動學","title":"肌動學第9章 · 側彎是三維變形，Cobb 角只描述其中一個面向","path":"library/kinesiology/ch09/#scoliosis","rel":"同一概念","why":"兩邊都在說明三維運動同時含旋轉與平移，脊柱側彎伴隨旋轉是耦合運動的例子。"}],"neumann.ch06.nerve-pathways":[{"to":"nordin.ch14.sensation-blood","book":"生物力學","title":"生物力學第14章 · 感覺與血流，也是手部操作的條件","path":"library/basic-biomechanics/ch14/#sensation-blood","rel":"同一概念","why":"兩段皆談橈、正中、尺神經對前臂與手部肌肉與感覺的支配"}],"nordin.ch14.sensation-blood":[{"to":"neumann.ch06.nerve-pathways","book":"肌動學","title":"肌動學第6章 · 神經路徑把相鄰肌肉分成不同功能群","path":"library/kinesiology/ch06/#nerve-pathways","rel":"同一概念","why":"兩段皆談橈、正中、尺神經對前臂與手部肌肉與感覺的支配"},{"to":"neumann.ch08.hand-sensation","book":"肌動學","title":"肌動學第8章 · 神經分工與精細感覺","path":"library/kinesiology/ch08/#hand-sensation","rel":"同一概念","why":"兩邊都談手部神經分工，它偏運動單位大小與分級，這裡偏感覺皮膚與抓握底座條件"},{"to":"neumann.ch08.grasp-task","book":"肌動學","title":"肌動學第8章 · 手作為效應器","path":"library/kinesiology/ch08/#grasp-task","rel":"同一概念","why":"這裡補上神經支配與感覺回饋條件，深化它手作為效應器的功能討論"},{"to":"neumann.ch08.sensory-protection","book":"肌動學","title":"肌動學第8章 · 感覺缺失與任務安全","path":"library/kinesiology/ch08/#sensory-protection","rel":"同一概念","why":"兩邊都談手部感覺神經分布與抓握安全，這裡補掌背皮膚差異與神經功能分工"},{"to":"neumann.ch08.carpal-tunnel","book":"肌動學","title":"肌動學第8章 · 腕隧道與正中神經","path":"library/kinesiology/ch08/#carpal-tunnel","rel":"應用","why":"這裡補充正中神經感覺與精細操作分布，對應它腕隧道壓迫的臨床表現"},{"to":"neumann.ch08.nerve-clinical-link","book":"肌動學","title":"肌動學第8章 · 神經損傷與腱移位案例","path":"library/kinesiology/ch08/#nerve-clinical-link","rel":"應用","why":"這裡補充電腦三神經的感覺與運動分布，呼應它神經損傷案例"}],"neumann.ch04.mass-moment":[{"to":"nordin.ch01.rotational-inertia","book":"生物力學","title":"生物力學第1章 · 旋轉分析需要轉動慣量","path":"library/basic-biomechanics/ch01/#rotational-inertia","rel":"同一概念","why":"兩段皆談 I=Σmr² 及 M=Iα 的轉動慣量定義"},{"to":"nordin.ch07.distal-inertia","book":"生物力學","title":"生物力學第7章 · 遠端加重同時改變重力矩與轉動慣量","path":"library/basic-biomechanics/ch07/#distal-inertia","rel":"同一概念","why":"它用膝力矩與距