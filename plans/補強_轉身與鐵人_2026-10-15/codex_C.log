{{- /* Vortex 首頁（Claude 手寫；2026-10-14 三層重構改骨架）：大標題 → 三個入口（知識／應用／研究庫）→ 六式 → 反直覺誤區 → L0–L6 階梯。
     原「主題與長期規劃」「直接查找」兩段併入三入口，不再各自成段。 */ -}}
{{- $d := hugo.Data.vortex_links -}}
{{- $order := slice "free" "back" "breast" "fly" "udk" "starts-turns" -}}
{{- $long := dict "free" "freestyle" "back" "backstroke" "breast" "breaststroke" "fly" "butterfly" "udk" "underwater_dolphin_kick" "starts-turns" "starts_turns" -}}
{{- $cnt := dict -}}
{{- $errBy := dict -}}
{{- range $id, $u := $d.units -}}
  {{- $cnt = merge $cnt (dict $u.type (add (index $cnt $u.type | default 0) 1)) -}}
  {{- if eq $u.type "error" -}}{{- $errBy = merge $errBy (dict $u.stroke ((index $errBy $u.stroke | default slice) | append $id)) -}}{{- end -}}
{{- end -}}
{{- $links := 0 -}}{{- range $d.out -}}{{- $links = add $links (len .) -}}{{- end -}}
{{- $css := resources.Get "css/home.css" | fingerprint -}}
<link rel="stylesheet" href="{{ $css.RelPermalink }}">

<article class="vx-home">
  <header class="vh-hero">
    <p class="kicker">VORTEX · 水感知識庫</p>
    <h1 class="vh-title">水感</h1>
    <p class="vh-lead">技術是水感的輸出，不是要照抄的動作。這裡把六種泳式拆成一個個動作，每個動作都接到怎麼練、常見的錯誤想法、背後的物理，以及練不起來時該看哪裡。</p>
    <p><a class="vh-more" href="{{ relURL "vortex/water-sense/" }}">第一次來？先讀：什麼是水感 →</a></p>
    <p class="vh-stats">
      <span><b>{{ index $cnt "move" }}</b> 個動作</span>
      <span><b>{{ index $cnt "drill" }}</b> 個練習</span>
      <span><b>{{ index $cnt "error" }}</b> 條教學誤區</span>
      <span><b>{{ lang.FormatNumber 0 $links }}</b> 條知識連結</span>
    </p>
  </header>


  <section class="vh-sec" aria-labelledby="vh-layers">
    <h2 id="vh-layers">三個入口</h2>
    <div class="vh-layers">
      <div class="vh-layer">
        <p class="vh-layer-name">知識</p>
        <p class="vh-layer-d">整理好的知識點：六種泳式拆成一個個動作，每個動作接到練法、誤區與背後的物理。</p>
        <ul>
          <li><a href="#vh-strokes">從一種泳式開始</a></li>
          <li><a href="{{ relURL "vortex/levels/" }}">水感發展地圖 L0–L6</a></li>
          <li><a href="{{ relURL "vortex/breathing/" }}">呼吸</a>・<a href="{{ relURL "vortex/psychology/" }}">心理層</a>・<a href="{{ relURL "vortex/joints/" }}">骨關節</a></li>
          <li><a href="{{ relURL "vortex/drills/" }}">{{ index $cnt "drill" }} 個練習</a>・<a href="{{ relURL "vortex/tech/" }}">技術分析</a>・<a href="{{ relURL "vortex/injuries/" }}">運動傷害</a></li>
        </ul>
      </div>
      <div class="vh-layer">
        <p class="vh-layer-name">應用</p>
        <p class="vh-layer-d">把知識變成下水前的決定：卡關時找處理、排一堂課、選器材、看長期發展。</p>
        <ul>
          <li><a href="{{ relURL "vortex/problems/" }}">找問題：練不起來時</a></li>
          <li><a href="{{ relURL "vortex/workout/" }}">課表與間歇計時</a></li>
          <li><a href="{{ relURL "vortex/instructional/equipment-guide/" }}">器材使用指南</a></li>
          <li><a href="{{ relURL "vortex/adm/" }}">運動員發展 ADM</a>・<a href="{{ relURL "vortex/periodization/" }}">訓練週期化</a></li>
        </ul>
      </div>
      <div class="vh-layer">
        <p class="vh-layer-name">研究庫</p>
        <p class="vh-layer-d">每句話從哪裡來：來源與查證狀態、哪些說法被改過、還在整理的研究筆記。</p>
        <ul>
          <li><a href="{{ relURL "vortex/research/sources/" }}">{{ len hugo.Data.vortex.source_usage.sources }} 筆來源</a></li>
          <li><a href="{{ relURL "vortex/research/rulings/" }}">審查與裁決紀錄</a></li>
          <li><a href="{{ relURL "vortex/research/notes/" }}">研究筆記</a>・<a href="{{ relURL "vortex/research/drafts/" }}">研究底稿</a></li>
          <li><a href="{{ relURL "vortex/research/" }}">研究庫首頁：確定性標記怎麼讀</a></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="vh-sec" aria-labelledby="vh-strokes">
    <h2 id="vh-strokes">從一種泳式開始</h2>
    <div class="vh-strokes">
    {{- range $order }}
      {{- $k := . }}
      {{- $s := index $d.strokes $k }}
      {{- $ln := index $long $k }}
      {{- $nd := 0 }}{{ range $d.units }}{{ if and (eq .type "drill") (in .record.strokes $ln) }}{{ $nd = add $nd 1 }}{{ end }}{{ end }}
      {{- $first := index (split (plainify $s.premise) "。") 0 }}
      <a class="vh-stroke" href="{{ relURL (printf "vortex/%s/" $k) }}">
        <span class="vh-stroke-name">{{ $s.name_zh }}</span>
        <span class="vh-stroke-premise">{{ $first }}。</span>
        <span class="vh-stroke-meta">{{ len $s.moves }} 個動作 · {{ $nd }} 個練習 · {{ len (index $errBy $k | default slice) }} 條誤區</span>
      </a>
    {{- end }}
    </div>
  </section>

  {{- $picks := slice -}}
  {{- range $i := seq 0 2 }}{{ range $order }}{{ $l := index $errBy . | default slice }}{{ if lt $i (len $l) }}{{ $picks = $picks | append (index (sort $l) $i) }}{{ end }}{{ end }}{{ end -}}
  {{- $picks = first 7 $picks -}}
  <section class="vh-sec" aria-labelledby="vh-myth">
    <h2 id="vh-myth">你可能一直以為的事</h2>
    <p class="vh-sec-lead">教學現場流傳很久、但物理上站不住的說法。每一條都附上為什麼，以及該怎麼改。</p>
    {{- with index $d.units (index $picks 0) }}
    <a class="vh-myth-feature" href="{{ relURL .path }}">
      <span class="vh-myth-label">很多人以為</span>
      <span class="vh-myth-quote">{{ .title }}</span>
      {{- with .record.correct_concept }}<span class="vh-myth-truth"><b>其實</b>{{ . | plainify | truncate 90 }}</span>{{ end }}
      <span class="vh-more">讀這一條 →</span>
    </a>
    {{- end }}
    <div class="vh-myths">
    {{- range after 1 $picks }}{{ with index $d.units . }}
      <a class="vh-myth" href="{{ relURL .path }}">
        <span class="vh-myth-stroke">{{ (index $d.strokes .stroke).name_zh }}</span>
        <span class="vh-myth-title">{{ .title }}</span>
      </a>
    {{- end }}{{ end }}
    </div>
    <p><a class="vh-more" href="{{ relURL "vortex/errors/" }}">看全部 {{ index $cnt "error" }} 條教學誤區 →</a></p>
  </section>

  <section class="vh-sec" aria-labelledby="vh-ladder">
    <h2 id="vh-ladder">水感怎麼一級一級長出來</h2>
    <p class="vh-sec-lead">從還不敢把臉放進水裡，到感知完全自動化。以下以自由式為例，其他泳式的級別在各泳式頁。</p>
    <ol class="vh-ladder">
    {{- range seq 0 6 }}{{ with index $d.units (printf "free.L%d" .) }}
      <li><a href="{{ relURL .path }}"><span class="vh-l">{{ .record.level }}</span><span class="vh-l-name">{{ .title }}</span><span class="vh-l-tag">{{ .record.tagline | plainify }}</span></a></li>
    {{- end }}{{ end }}
    </ol>
  </section>

</article>
{{- /* Vortex 常駐目錄（鐵則 G：參考型內容要有空間化導航）。桌機左欄黏著；手機收成「Vortex 目錄」。 */ -}}
{{- $d := hugo.Data.vortex_links -}}
{{- $here := .RelPermalink -}}
{{- $cur := "" -}}
{{- with .Params.stroke }}{{ $cur = . }}{{ end -}}
{{- with .Params.unit_id }}{{ with index $d.units . }}{{ $cur = .stroke }}{{ end }}{{ end -}}
{{- $order := slice "free" "back" "breast" "fly" "udk" "starts-turns" -}}
{{- /* 2026-10-14 三層重構：知識（呈現）／應用／研究庫（資料庫）。層標題用 rail-series，子群用 rail-h。 */ -}}
{{- $lists := slice
  (dict "p" "drills" "t" "練習" "n" "drill")
  (dict "p" "errors" "t" "教學誤區" "n" "error")
  (dict "p" "tech" "t" "技術分析" "n" "tech")
  (dict "p" "injuries" "t" "運動傷害" "n" "injury")
  (dict "p" "mind" "t" "心理概念" "n" "psy") -}}
{{- $topics := slice
  (dict "p" "breathing" "t" "呼吸")
  (dict "p" "psychology" "t" "心理層")
  (dict "p" "joints" "t" "骨關節動作")
  (dict "p" "movement" "t" "動作圖譜")
  (dict "p" "periodization" "t" "訓練週期化") -}}
{{- $apply := slice
  (dict "p" "problems" "t" "找問題：練不起來時")
  (dict "p" "workout" "t" "課表與間歇計時")
  (dict "p" "instructional/equipment-guide" "t" "器材使用指南")
  (dict "p" "adm" "t" "運動員發展 ADM") -}}
{{- $research := slice
  (dict "p" "research/sources" "t" "來源")
  (dict "p" "research/rulings" "t" "審查與裁決紀錄")
  (dict "p" "research/notes" "t" "研究筆記")
  (dict "p" "research/drafts" "t" "研究底稿") -}}
<details class="rail" id="rail">
  <summary class="rail-toggle">Vortex 目錄</summary>
  <nav aria-label="Vortex 目錄">
    <p class="rail-series">知識</p>
    <p class="rail-h">開始</p>
    <a class="rail-a{{ if eq $here (relURL "vortex/") }} is-here{{ end }}" href="{{ relURL "vortex/" }}">Vortex 首頁</a>
    <a class="rail-a{{ if eq $here (relURL "vortex/water-sense/") }} is-here{{ end }}" href="{{ relURL "vortex/water-sense/" }}">什麼是水感</a>
    <a class="rail-a{{ if hasPrefix $here (relURL "vortex/levels/") }} is-here{{ end }}" href="{{ relURL "vortex/levels/" }}">發展地圖 L0–L6</a>
    <p class="rail-h">六種泳式</p>
    {{- range $order }}
      {{- $s := index $d.strokes . }}
      {{- $sp := relURL (printf "vortex/%s/" .) }}
    <a class="rail-a{{ if eq $here $sp }} is-here{{ end }}{{ if eq $cur . }} is-open{{ end }}" href="{{ $sp }}">{{ $s.name_zh }}</a>
      {{- if eq $cur . }}
    <div class="rail-sub">
        {{- range $s.moves }}{{ with index $d.units . }}
      {{- $mp := relURL .path }}
      <a class="rail-a rail-a--sub{{ if eq $here $mp }} is-here{{ end }}" href="{{ $mp }}">{{ .record.n }}　{{ .title }}</a>
        {{- end }}{{ end }}
    </div>
      {{- end }}
    {{- end }}
    <p class="rail-h">主題</p>
    {{- range $topics }}
      {{- $tp := relURL (printf "vortex/%s/" .p) }}
    <a class="rail-a{{ if hasPrefix $here $tp }} is-here{{ end }}" href="{{ $tp }}">{{ .t }}</a>
    {{- end }}
    <p class="rail-h">查找</p>
    {{- range $lists }}
      {{- $lp := relURL (printf "vortex/%s/" .p) }}
    <a class="rail-a{{ if hasPrefix $here $lp }} is-here{{ end }}" href="{{ $lp }}">{{ .t }}</a>
    {{- end }}
    <p class="rail-series">應用</p>
    {{- range $apply }}
      {{- $ap := relURL (printf "vortex/%s/" .p) }}
    <a class="rail-a{{ if hasPrefix $here $ap }} is-here{{ end }}" href="{{ $ap }}">{{ .t }}</a>
    {{- end }}
    <p class="rail-series">研究庫</p>
    {{- $rh := relURL "vortex/research/" }}
    <a class="rail-a{{ if eq $here $rh }} is-here{{ end }}" href="{{ $rh }}">研究庫首頁</a>
    {{- range $research }}
      {{- $sp := relURL (printf "vortex/%s/" .p) }}
    <a class="rail-a{{ if eq $here $sp }} is-here{{ else if hasPrefix $here $sp }} is-open{{ end }}" href="{{ $sp }}">{{ .t }}</a>
      {{- if and (hasPrefix $here $sp) (ne $here $sp) (ne .p "research/sources") }}
    <div class="rail-sub">
      <a class="rail-a rail-a--sub is-here" href="{{ $here }}">{{ $.Title }}</a>
        {{- range $.Fragments.Headings }}{{ range .Headings }}{{ if eq .Level 2 }}
      <a class="rail-a rail-a--sub" href="#{{ .ID }}">{{ .Title | plainify }}</a>
        {{- end }}{{ end }}{{ if eq .Level 2 }}
      <a class="rail-a rail-a--sub" href="#{{ .ID }}">{{ .Title | plainify }}</a>
        {{- end }}{{ end }}
    </div>
      {{- end }}
    {{- end }}
  </nav>
</details>
<script>(function(){var r=document.getElementById('rail');if(r&&window.matchMedia('(min-width: 1000px)').matches){r.open=true;}})();</script>
{{- /* 全站首頁／書房（Claude 手寫）：Cortex 定位 → Vortex（主力研究）→ 書房（依領域分組的各系列）。站首頁與 /library/ 共用。 */ -}}
{{- $css := resources.Get "css/bookshelf.css" | fingerprint -}}
<link rel="stylesheet" href="{{ $css.RelPermalink }}">
{{- $v := hugo.Data.vortex_links -}}
{{- $vc := dict -}}{{- range $v.units -}}{{- $vc = merge $vc (dict .type (add (index $vc .type | default 0) 1)) -}}{{- end -}}
{{- $vl := 0 -}}{{- range $v.out -}}{{- $vl = add $vl (len .) -}}{{- end -}}
{{- $lib := hugo.Data.library -}}
<article class="bs">
  <header class="bs-hero">
    <p class="kicker">CORTEX · 個人知識庫</p>
    <h1 class="bs-title">Cortex</h1>
