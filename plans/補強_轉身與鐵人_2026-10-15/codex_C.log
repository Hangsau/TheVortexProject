            "hook": hook_from_drill(dr),
            "stroke": "",
            "category": cat,
            "category_name": cat_map_drill.get(cat, cat),
            "path": path_for("drill", uid),
            "record": dict(dr),
        }
        units[uid] = unit
        out_edges.setdefault(uid, [])
        in_edges.setdefault(uid, [])

