{{- /*
  stroke.html — 泳式樞紐頁版型（W6）。
  資料來源：hugo.Data.vortex_links。泳式 key 在 .Params.stroke。
  區塊依序：h1 + premise、動作、常見誤區、技術分析（依 category 分組）、
           練不起來時、這一式的練習、水感發展級別；空區不出。
*/ -}}
{{- $stroke := .Params.stroke -}}
{{- $links := hugo.Data.vortex_links -}}
{{- $s := index $links.strokes $stroke -}}

{{- $css := resources.Get "css/stroke.css" | fingerprint -}}
<link rel="stylesheet" href="{{ $css.RelPermalink }}" integrity="{{ $css.Data.Integrity }}" crossorigin="anonymous">

<article class="page page--wide stroke">
  <h1>{{ $s.name_zh }}</h1>
  {{- with $s.premise -}}
    {{- $t := . | plainify | strings.TrimSpace -}}
    {{- if $t -}}
      <p class="read">{{ . | markdownify }}</p>
    {{- end -}}
  {{- end -}}


  {{- /* ===== 動作 ===== */ -}}
  {{- $moves := $s.moves -}}
  {{- if $moves -}}
    {{- if gt (len $moves) 0 }}
    <section class="stroke-section stroke-moves">
      <h2>動作</h2>
      <div class="mv-list">
        {{- range $mid := $moves -}}
          {{- $mu := index $links.units $mid -}}
          {{- if $mu }}
          <div class="mv-row">
            <div class="mv-n">{{ $mu.record.n }}</div>
            <div class="mv-body">
              <a class="mv-name" href="{{ relURL $mu.path }}">{{ $mu.title }}</a>
              {{- with $mu.record.one -}}
                {{- $t := . | plainify | strings.TrimSpace -}}
                {{- if $t -}}<p class="muted mv-one">{{ . | markdownify }}</p>{{- end -}}
              {{- end -}}
              {{- $practiceIds := slice -}}
              {{- range $e := index $links.out $mid -}}
                {{- if eq $e.rel "practice" -}}
                  {{- $practiceIds = $practiceIds | append $e.to -}}
                {{- end -}}
              {{- end -}}
              {{- if gt (len $practiceIds) 0 }}
              <p class="mv-practice">
                {{- range $i, $pid := $practiceIds -}}
                  {{- if lt $i 3 -}}
                    {{- if $i }}　{{ end -}}
                    {{- $pu := index $links.units $pid -}}
                    {{- if $pu -}}<a href="{{ relURL $pu.path }}">{{ $pu.title }}</a>{{- end -}}
                  {{- end -}}
                {{- end -}}
                {{- $extra := sub (len $practiceIds) 3 -}}
                {{- if gt $extra 0 -}}
                  　<a class="mv-more" href="{{ relURL $mu.path }}">＋{{ $extra }}</a>
                {{- end -}}
              </p>
              {{- end -}}
            </div>
          </div>
          {{- end -}}
        {{- end -}}
      </div>
    </section>
    {{- end -}}
  {{- end -}}


  {{- /* ===== 這一式的常見誤區 ===== */ -}}
  {{- $errorIds := slice -}}
  {{- range $uid, $u := $links.units -}}
    {{- if and (eq $u.type "error") (eq $u.stroke $stroke) -}}
      {{- $n := 0 -}}
      {{- $nums := findRE "[0-9]+" $uid -}}
      {{- if gt (len $nums) 0 -}}
        {{- $n = index $nums (sub (len $nums) 1) | int -}}
      {{- end -}}
      {{- $errorIds = $errorIds | append (dict "id" $uid "n" $n) -}}
    {{- end -}}
  {{- end -}}
  {{- $errorIds = sort $errorIds ".n" "asc" -}}
      {{- range $uid := $probIds -}}
        {{- $u := index $links.units $uid -}}
        <li>
          <a class="sl-title" href="{{ relURL $u.path }}">{{ $u.title }}</a>
          {{- with $u.hook -}}
            {{- $t := . | plainify | strings.TrimSpace -}}
            {{- if $t -}}<p class="muted sl-hook">{{ . | markdownify }}</p>{{- end -}}
          {{- end -}}
        </li>
      {{- end -}}
    </ul>
  </section>
  {{- end -}}


  {{- /* ===== 這一式的練習（drill，按 strokes 對應） ===== */ -}}
  {{- $strokeMap := dict
    "freestyle" "free"
    "backstroke" "back"
    "breaststroke" "breast"
    "butterfly" "fly"
    "underwater_dolphin_kick" "udk"
    "starts_turns" "starts-turns"
  -}}
  {{- $drillIds := slice -}}
  {{- range $uid, $u := $links.units -}}
    {{- if eq $u.type "drill" -}}
      {{- $match := false -}}
      {{- range $s2 := $u.record.strokes -}}
        {{- if eq (index $strokeMap $s2) $stroke -}}
          {{- $match = true -}}
        {{- end -}}
      {{- end -}}
      {{- if $match -}}
        {{- $n := 0 -}}
        {{- $nums := findRE "[0-9]+" $uid -}}
        {{- if gt (len $nums) 0 -}}
          {{- $n = index $nums (sub (len $nums) 1) | int -}}
        {{- end -}}
        {{- $drillIds = $drillIds | append (dict "id" $uid "n" $n) -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
  {{- $drillIds = sort $drillIds ".n" "asc" -}}
  {{- if gt (len $drillIds) 0 }}
  <section class="stroke-section stroke-drills">
    <h2>這一式的練習</h2>
    {{- $firstDr := first 8 $drillIds -}}
    {{- $restDr := after 8 $drillIds -}}
    <ul class="stroke-list">
      {{- range $it := $firstDr -}}
        {{- $u := index $links.units $it.id -}}
        <li>
          <a class="sl-title" href="{{ relURL $u.path }}">{{ $u.title }}</a>
        </li>
      {{- end -}}
    </ul>
    {{- if gt (len $restDr) 0 }}
    <details class="stroke-more">
      <summary>看全部 {{ len $drillIds }} 條</summary>
      <ul class="stroke-list">
        {{- range $it := $restDr -}}
          {{- $u := index $links.units $it.id -}}
          <li>
            <a class="sl-title" href="{{ relURL $u.path }}">{{ $u.title }}</a>
          </li>
        {{- end -}}
      </ul>
    </details>
    {{- end -}}
    <p class="stroke-tail"><a href="{{ relURL "vortex/drills/" }}">在練習清單中篩選 →</a></p>
  </section>
  {{- end -}}


  {{- /* ===== 水感發展級別（level） ===== */ -}}
  {{- $levelIds := slice -}}
  {{- range $uid, $u := $links.units -}}
    {{- if and (eq $u.type "level") (eq $u.stroke $stroke) -}}
      {{- $n := 0 -}}
      {{- $nums := findRE "[0-9]+" $uid -}}
      {{- if gt (len $nums) 0 -}}
        {{- $n = index $nums (sub (len $nums) 1) | int -}}
      {{- end -}}
      {{- $levelIds = $levelIds | append (dict "id" $uid "n" $n) -}}
    {{- end -}}
  {{- end -}}
  {{- $levelIds = sort $levelIds ".n" "asc" -}}
  {{- if gt (len $levelIds) 0 }}
  <section class="stroke-section stroke-levels">
    <h2>水感發展級別</h2>
    <ul class="stroke-list">
      {{- range $it := $levelIds -}}
        {{- $u := index $links.units $it.id -}}
        <li>
          <a class="sl-title" href="{{ relURL $u.path }}">{{ $u.title }}</a>
          {{- with $u.hook -}}
            {{- $t := . | plainify | strings.TrimSpace -}}
            {{- if $t -}}<p class="muted sl-hook">{{ . | markdownify }}</p>{{- end -}}
          {{- end -}}
        </li>
      {{- end -}}
    </ul>
  </section>
  {{- end -}}
</article>
{{- /*
  list.html — 集合清單頁版型（W7）。
  依 .Params.list_type（move / drill / tech / error / problem / injury / level / psy）列出項目。
  篩選互動交給 assets/js/filter.js（defer 載入）；樣式見 assets/css/list.css。
*/ -}}
{{- $type := .Params.list_type -}}
{{- $links := hugo.Data.vortex_links -}}
{{- $units := $links.units -}}
{{- $strokes := $links.strokes -}}

{{- $strokeName := dict
  "free" "自由式"
  "back" "仰式"
  "breast" "蛙式"
  "fly" "蝶式"
  "udk" "水下海豚腿"
  "starts-turns" "出發與轉身"
-}}

{{- $css := resources.Get "css/list.css" | fingerprint -}}
<link rel="stylesheet" href="{{ $css.RelPermalink }}" integrity="{{ $css.Data.Integrity }}" crossorigin="anonymous">

{{- /* 收集該類型的所有項目，依 stroke 與 id 排序；psy 另處理 */ -}}
{{- $strokeOrder := slice "free" "back" "breast" "fly" "udk" "starts-turns" -}}
{{- $strokePos := dict "free" 0 "back" 1 "breast" 2 "fly" 3 "udk" 4 "starts-turns" 5 -}}

{{- /* drill 的 strokes（資料）→ 內部 key；多值用空白串接成 data-stroke */ -}}
{{- $strokeToKey := dict
  "freestyle" "free"
  "backstroke" "back"
  "breaststroke" "breast"
  "butterfly" "fly"
  "underwater_dolphin_kick" "udk"
  "starts_turns" "starts-turns"
-}}

{{- /* 統計該類型實際出現的泳式與類別 */ -}}
{{- $usedStrokes := dict -}}
{{- $usedCategories := dict -}}
{{- range $uid, $u := $units -}}
  {{- if eq $u.type $type -}}
    {{- if eq $type "drill" -}}
      {{- range $s := $u.record.strokes -}}
        {{- $k := index $strokeToKey $s -}}
        {{- if $k -}}
          {{- $usedStrokes = merge $usedStrokes (dict $k true) -}}
        {{- end -}}
      {{- end -}}
    {{- else if $u.stroke -}}
      {{- $usedStrokes = merge $usedStrokes (dict $u.stroke true) -}}
    {{- end -}}
    {{- if and $u.category_name (ne $u.category_name "") -}}
      {{- $usedCategories = merge $usedCategories (dict $u.category_name true) -}}
    {{- end -}}
  {{- end -}}
{{- end -}}

{{- /* 篩選維度：哪些要輸出 */ -}}
{{- $hasStrokeFilter := in (slice "move" "drill" "tech" "error" "problem" "level") $type -}}
{{- $hasCategoryFilter := in (slice "drill" "tech" "error" "problem" "injury") $type -}}
{{- $hasEquipFilter := eq $type "drill" -}}

{{- /* 整理 items，依 stroke 順序與 id 排序 */ -}}
{{- $items := slice -}}
{{- if eq $type "psy" -}}
  {{- $psyList := slice -}}
  {{- range $uid, $u := $units -}}
    {{- if eq $u.type "psy" -}}
      {{- $psyList = $psyList | append $uid -}}
    {{- end -}}
  {{- end -}}
  {{- range $pid := $psyList -}}
    {{- $items = $items | append (dict "uid" $pid "stroke" "" "category" "" "equip" "" "indent" 0) -}}
    {{- range $e := index $links.in $pid -}}
      {{- if eq $e.rel "part_of" -}}
        {{- $items = $items | append (dict "uid" $e.from "stroke" "" "category" "" "equip" "" "indent" 1) -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
{{- else -}}
  {{- $typed := slice -}}
  {{- range $uid, $u := $units -}}
    {{- if eq $u.type $type -}}
      {{- $strokeKey := $u.stroke -}}
      {{- $pos := -1 -}}
      {{- if $strokeKey -}}
        {{- $pos = index $strokePos $strokeKey | default -1 -}}
      {{- end -}}
      {{- $typed = $typed | append (dict "uid" $uid "stroke" $strokeKey "pos" $pos "category" $u.category_name) -}}
    {{- end -}}
  {{- end -}}
  {{- $typed = sort $typed "pos" "asc" -}}
  {{- $typed = sort $typed "uid" "asc" -}}
  {{- range $t := $typed -}}
    {{- $items = $items | append (dict "uid" $t.uid "stroke" $t.stroke "category" $t.category "equip" "" "indent" 0) -}}
  {{- end -}}
{{- end -}}

{{- $count := len $items -}}

<article class="page page--wide list" data-list data-type="{{ $type }}">
  <h1>{{ .Title }}</h1>
  <p class="muted list-count">共 <span class="count-n">{{ $count }}</span> 條</p>

  {{- if or $hasStrokeFilter $hasCategoryFilter $hasEquipFilter }}
  <section class="ls-sec mv-sec" id="demands-sec" aria-labelledby="demands-h">
    <h2 id="demands-h">泳式需求（{{ len $demands }}）</h2>

    {{- range $stroke := $demandStrokes -}}
      {{- $groupDemands := slice -}}
      {{- range $d := $demands -}}
        {{- $s := "" -}}
        {{- with $d.stroke -}}{{- $s = . -}}{{- end -}}
        {{- if not $s -}}{{- $s = "_none" -}}{{- end -}}
        {{- if eq $s $stroke -}}{{- $groupDemands = $groupDemands | append $d -}}{{- end -}}
      {{- end -}}
      {{- if gt (len $groupDemands) 0 -}}
        {{- $label := $stroke -}}
        {{- if eq $stroke "free" -}}{{- $label = "自由式" -}}{{- end -}}
        {{- if eq $stroke "back" -}}{{- $label = "仰式" -}}{{- end -}}
        {{- if eq $stroke "breast" -}}{{- $label = "蛙式" -}}{{- end -}}
        {{- if eq $stroke "fly" -}}{{- $label = "蝶式" -}}{{- end -}}
        {{- if eq $stroke "udk" -}}{{- $label = "水下海豚腿" -}}{{- end -}}
        {{- if eq $stroke "starts-turns" -}}{{- $label = "起跳轉身" -}}{{- end -}}
        {{- if eq $stroke "_none" -}}{{- $label = "未標示泳式" -}}{{- end -}}
    <div class="mv-group">
      <p class="ls-part">{{ $label }}（{{ len $groupDemands }}）</p>
      <ul class="mv-list">
        {{- range $d := $groupDemands -}}
        <li id="{{ $d.id }}">
          {{- $title := "" -}}
          {{- with $d.name_zh -}}{{- $title = . -}}{{- end -}}
          {{- if not $title -}}{{- with $d.name -}}{{- $title = . -}}{{- end -}}{{- end -}}
          {{- if not $title -}}{{- $title = $d.id -}}{{- end -}}
          <span class="mv-name">{{ $title }}</span>
          {{- with $d.claim_status }}<span class="mv-cert">主張：{{ . }}</span>{{- end -}}
          {{- if $d.description -}}<p class="mv-desc">{{ $d.description | plainify | strings.TrimSpace }}</p>{{- end -}}
          {{- if $d.action_ids -}}<p class="mv-xref"><span class="mv-xref-label">相關動作</span>
            {{- range $lid := $d.action_ids -}}{{- $n := index $nameById $lid -}}{{- if not $n -}}{{- $n = $lid -}}{{- end -}}<a href="#{{ $lid }}">{{ $n }}</a>
            {{- end -}}</p>{{- end -}}
          {{- if $d.muscle_roles -}}<p class="mv-xref"><span class="mv-xref-label">相關肌群</span>
            {{- range $mr := $d.muscle_roles -}}{{- $mid := $mr.muscle_id -}}{{- $n := index $nameById $mid -}}{{- if not $n -}}{{- $n = $mid -}}{{- end -}}<a href="#{{ $mid }}">{{ $n }}</a>
            {{- end -}}</p>{{- end -}}
