            {{- $s := "" -}}{{- if reflect.IsSlice $v -}}{{- $s = delimit $v " " -}}{{- else if $v -}}{{- $s = string $v -}}{{- end -}}
            {{- $axAttrs = printf "%s data-%s=\"%s\"" $axAttrs $ax.dim $s -}}
          {{- end -}}
        {{- end -}}
        <li data-uid="{{ $uid }}" data-stroke="{{ $dataStroke }}" data-category="{{ $dataCategory }}" data-equip="{{ $dataEquip }}" data-indent="{{ $it.indent }}"{{ $axAttrs | safeHTMLAttr }}>
