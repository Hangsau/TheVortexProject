3/#hoop-stress","rel":"同一概念","why":"兩邊都在講半月板把壓縮轉成環向張力與接觸面擴展"},{"to":"neumann.ch13.femoral-tibial-geometry","book":"肌動學","title":"肌動學第13章 · 股骨與脛骨的形狀，留下軟組織要完成的工作","path":"library/kinesiology/ch13/#femoral-tibial-geometry","rel":"同一概念","why":"兩邊都談膝關節骨形不足由半月板與軟組織補足"},{"to":"neumann.ch13.roll-slide","book":"肌動學","title":"肌動學第13章 · 滾動與滑動的方向，要跟著移動面切換","path":"library/kinesiology/ch13/#roll-slide","rel":"應用","why":"它講凹凸面滾動滑動規則，這裡談半月板讓力傳遞位置改變，補充膝關節接觸面實務"}],"neumann.ch14.muscular-sling":[{"to":"nordin.ch09.muscle-axes","book":"生物力學","title":"生物力學第9章 · 肌腱相對轉軸的位置，決定多重力矩","path":"library/basic-biomechanics/ch09/#muscle-axes","rel":"機制","why":"它解釋肌腱相對轉軸位置決定多重力矩，補這裡的肌肉協作描述"},{"to":"movement.muscle.foot-evertors","book":"Vortex","title":"Vortex 動作圖譜 · 足外翻肌群","path":"vortex/movement/#movement.muscle.foot-evertors","rel":"機制","why":"它列足外翻肌群，這裡解釋腓骨肌群與脛後肌在支撐足弓中的交互作用"},{"to":"nordin.ch09.midtarsal-twist","book":"生物力學","title":"生物力學第9章 · 中足鎖定與前足扭轉，是不同尺度的描述","path":"library/basic-biomechanics/ch09/#midtarsal-twist","rel":"同一概念","why":"這裡談脛後肌與腓骨長肌的吊帶作用，它談中足鎖定與前足扭轉"},{"to":"nordin.ch17.posterior-muscles","book":"生物力學","title":"生物力學第17章 · 踝後方肌腱所屬肌群也參與距下與足部控制","path":"library/basic-biomechanics/ch17/#posterior-muscles","rel":"同一概念","why":"這裡談腓骨長肌與脛後肌吊帶，它列出踝後方五肌並詳述脛後肌功能"},{"to":"nordin.ch09.posterior-tibial-case","book":"生物力學","title":"生物力學第9章 · 脛後肌病例把症狀、變形與抬跟放在一起讀","path":"library/basic-biomechanics/ch09/#posterior-tibial-case","rel":"應用","why":"這裡說明脛後肌與腓骨長肌支撐足弓的機制，它以脛後肌腱病例呈現失能後的臨床變形"}],"nordin.ch09.muscle-axes":[{"to":"neumann.ch14.muscular-sling","book":"肌動學","title":"肌動學第14章 · 腓骨長肌與脛後肌可以互相抵銷，也可以共同支撐","path":"library/kinesiology/ch14/#muscular-sling","rel":"機制","why":"這裡解釋肌腱相對轉軸位置決定多重力矩，補它的肌肉協作描述"},{"to":"neumann.ch14.fibularis-path","book":"肌動學","title":"肌動學第14章 · 腓骨長短肌的繞行，形成外側穩定與蹠屈作用","path":"library/kinesiology/ch14/#fibularis-path","rel":"機制","why":"它講腓骨肌腱繞行產生外翻加蹠屈，這裡從肌腱相對轉軸位置解釋多重力矩，機制互補"},{"to":"movement.muscle.ankle-dorsiflexors","book":"Vortex","title":"Vortex 動作圖譜 · 踝背屈肌群","path":"v