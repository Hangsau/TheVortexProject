/ch15/#ankle-sagittal","rel":"同一概念","why":"它講踝角度與吸震推進，這裡講踝足肌群對應活化時序，讀它看這裡得肌肉分工"},{"to":"neumann.ch14.dorsiflexors","book":"肌動學","title":"肌動學第14章 · 前腔室肌群讓足離地，也控制落地聲響","path":"library/kinesiology/ch14/#dorsiflexors","rel":"同一概念","why":"兩節皆述脛前肌在擺盪背屈與承重離心控制的時序與角色"},{"to":"neumann.ch15.weight-acceptance","book":"肌動學","title":"肌動學第15章 · 承重初期需要控制身體的移動","path":"library/kinesiology/ch15/#weight-acceptance","rel":"同一概念","why":"兩節同述承重期前脛肌離心控制與背屈肌時序"},{"to":"movement.muscle.ankle-dorsiflexors","book":"Vortex","title":"Vortex 動作圖譜 · 踝背屈肌群","path":"vortex/movement/#movement.muscle.ankle-dorsiflexors","rel":"同一概念","why":"都講脛前肌等踝背屈肌的功能，圖譜對應步態活化分布"},{"to":"neumann.ch14.plantarflexor-control","book":"肌動學","title":"肌動學第14章 · 蹠屈肌先煞住小腿前移，再協助推進","path":"library/kinesiology/ch14/#plantarflexor-control","rel":"同一概念","why":"都講踝蹠屈肌在站立期離心煞車再推進的時序"},{"to":"neumann.ch14.chapter-bridge","book":"肌動學","title":"肌動學第14章 · 把接觸、形變與肌肉時序連成一個步態週期","path":"library/kinesiology/ch14/#chapter-bridge","rel":"同一概念","why":"兩邊都講前脛肌群在承重反應期離心控制與擺盪期向心背屈"},{"to":"neumann.ch15.hip-flexor-abductor-emg","book":"肌動學","title":"肌動學第15章 · 髖屈肌群與外展肌群","path":"library/kinesiology/ch15/#hip-flexor-abductor-emg","rel":"應用","why":"它談髖屈肌在步態中的時序，這裡補踝足肌群於站立與擺盪的活化分布"},{"to":"movement.muscle.ankle-plantarflexors","book":"Vortex","title":"Vortex 動作圖譜 · 踝蹠屈肌群","path":"vortex/movement/#movement.muscle.ankle-plantarflexors","rel":"應用","why":"它講踝蹠屈肌群組成，這裡補充步態中背屈與蹠屈的時序活化"},{"to":"neumann.ch15.stance-swing","book":"肌動學","title":"肌動學第15章 · 站立相與擺盪相各佔週期的比例","path":"library/kinesiology/ch15/#stance-swing","rel":"應用","why":"它談站立擺盪相週期比例，這裡談踝足肌群活化在站立擺盪期的時序，兩者直接對應同一週期"}],"neumann.ch14.subtalar-structure":[{"to":"free.tech.38","book":"Vortex","title":"Vortex · 踝的三維擺動","path":"vortex/tech/free-tech-38/","rel":"機制","why":"這裡解釋距下關節多面接觸與韌帶穩定，幫讀它的人理解踝內外翻不在距小腿"},{"to":"nordin.ch09.subtalar-reference","book":"生物力學","title":"生物力學第9章 · 距下關節讓小腿轉向，腳底仍可留在地面","path":"library/basic-biomechanics/ch09/#subtalar-reference","rel":"同一概念","why":"都解析距下關節三個關節面與韌帶穩定機制"},{"to":"nordin.ch17.subtalar","book":"生物力學","title":"生物力學第17章 · 距下關節的姿位改變足部的順應性","path":"library/basic-biomechanics/ch17/#subtalar","rel":"同一概念","why":"兩邊都談距下關節構造與其在步態中的穩定與活動"},{"to":"nordin.ch09.loaded-stability","book":"生物力學","title":"生物力學第9章 · 承重通常增加踝穩定，研究仍須看旋轉約束","path":"library/basic-biomechanics/ch09/#loaded-stability","rel":"應用","why":"這裡講距下三接觸面與骨間韌帶穩定，它補承重增加骨面穩定但韌帶切斷後仍有傾斜的研究結果"},{"to":"nordin.ch09.sprain-mechanics","book":"生物力學","title":"生物力學第9章 · 外側扭傷要同時看方向、速度與組織狀態","path":"library/basic-biomechanics/ch09/#sprain-mechanics","rel":"應用","why":"這裡講距下關節韌帶穩定，它講踝外側韌帶損傷機制，同屬踝部韌帶"}],"nordin.ch09.subtalar-reference":[{"to":"neumann.ch14.loaded-pronation","book":"肌動學","title":"肌動學第14章 · 承重早期，後足旋前可伴前足相對旋後","path":"library/kinesiology/ch14/#loaded-pronation","rel":"機制","why":"這裡距下關節斜軸說明它承重時後足旋前的骨頭相對運動"},{"to":"movement.muscle.foot-evertors","book":"Vortex","title":"Vortex 動作圖譜 · 足外翻肌群","path":"vortex/movement/#movement.muscle.foot-evertors","rel":"機制","why":"這裡補距下關節三維運動機制，接它外翻肌群的解剖作用線"},{"to":"neumann.ch14.subtalar-structure","book":"肌動學","title":"肌動學第14章 · 距下關節的三個接觸面一起產生斜向活動","path":"library/kinesiology/ch14/#subtalar-structure","rel":"同一概念","why":"都解析距下關節三個關節面與韌帶穩定機制"},{"to":"neumann.ch14.subtalar-axis","book":"肌動學","title":"肌動學第14章 · 距下斜軸把足跟側傾和水平旋轉連起來","path":"library/kinesiology/ch14/#subtalar-axis","rel":"同一概念","why":"兩邊都在描述距下斜軸的角度與三平面運動，數據與概念互補"},{"to":"neumann.ch14.adaptation","book":"肌動學","title":"肌動學第14章 · 多個關節共同改變足部形狀","path":"library/kinesiology/ch14/#adaptation","rel":"同一概念","why":"兩邊都談懸空與承重時距下及各足部關節的相對運動差異"},{"to":"neumann.ch16.rearfoot-motion","book":"肌動學","title":"肌動學第16章 · 足跟外翻的峰值與活動幅度是兩種描述","path":"library/kinesiology/ch16/#rearfoot-motion","rel":"同一概念","why":"它與這裡都談距下關節內外翻測量的限制與承重時的描述差異"},{"to":"neumann.ch14.deltoid","book":"肌動學","title":"肌動學第14章 · 三角韌帶跨越內側多個關節","path":"library/kinesiology/ch14/#deltoid","rel":"同一概念","why":"兩邊都講距下關節斜軸與小腿／足相對轉動的穩定結構"},{"to":"neumann.ch14.oblique-motion","book":"肌動學","title":"肌動學第14章 · 旋前與旋後，是斜軸動作的平面成分","path":"library/ki