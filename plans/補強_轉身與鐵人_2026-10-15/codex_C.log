rface","rel":"應用","why":"它月狀面接觸面與壓力分布補完這裡髖臼包覆角度的臨床解讀"},{"to":"nordin.ch08.angle-comparison","book":"生物力學","title":"生物力學第8章 · 兩冊角度不同，先保留定義與來源","path":"library/basic-biomechanics/ch08/#angle-comparison","rel":"數據","why":"這裡與它交叉對照CE角與前傾角的兩冊參考值差異"}],"nordin.ch08.angle-comparison":[{"to":"neumann.ch12.neck-shaft-angle","book":"肌動學","title":"肌動學第12章 · 頸幹角描述額狀面傾斜，也改變力臂","path":"library/kinesiology/ch12/#neck-shaft-angle","rel":"同一概念","why":"兩邊都提醒讀者比較不同來源角度數值差異時應保留定義與出處"},{"to":"neumann.ch12.chapter-bridge","book":"肌動學","title":"肌動學第12章 · 用三步把髖的構造、動作與負荷接起來","path":"library/kinesiology/ch12/#chapter-bridge","rel":"同一概念","why":"它給髖構造與角度量測步驟，這裡比較兩冊 CE 角與頸幹角參考值的差異"},{"to":"neumann.ch12.acetabular-coverage","book":"肌動學","title":"肌動學第12章 · 髖臼包覆要分額狀面與水平面","path":"library/kinesiology/ch12/#acetabular-coverage","rel":"數據","why":"它與這裡交叉對照CE角與前傾角的兩冊參考值差異"}],"neumann.ch06.lateral-ligaments":[{"to":"nordin.ch13.varus-stability","book":"生物力學","title":"生物力學第13章 · 內翻約束的小比例，不等於旋轉穩定不重要","path":"library/basic-biomechanics/ch13/#varus-stability","rel":"機制","why":"這裡描述外側尺副韌帶限制後外旋，它提供標本試驗的量化分配"},{"to":"nordin.ch13.side-stability","book":"生物力學","title":"生物力學第13章 · 內外側穩定會隨角度與負荷方向分工","path":"library/basic-biomechanics/ch13/#side-stability","rel":"同一概念","why":"都講肘內外側韌帶在不同角度與負荷下分工穩定"}],"nordin.ch13.varus-stability":[{"to":"neumann.ch06.lateral-ligaments","book":"肌動學","title":"肌動學第6章 · 外側韌帶也在防止後外側旋轉","path":"library/kinesiology/ch06/#lateral-ligaments","rel":"機制","why":"它描述外側尺副韌帶限制後外旋，這裡提供標本試驗的量化分配"},{"to":"neumann.ch06.distal-humerus","book":"肌動學","title":"肌動學第6章 · 先辨認肱骨遠端的兩個接觸面","path":"library/kinesiology/ch06/#distal-humerus","rel":"同一概念","why":"它辨認肘部骨接觸面，這裡談關節面與韌帶在肘部穩定中的比例分配"},{"to":"neumann.ch13.collateral-ligaments","book":"肌動學","title":"肌動學第13章 · 副韌帶依方向與束別提供約束","path":"library/kinesiology/ch13/#collateral-ligaments","rel":"數據","why":"這裡提供 55%／9% 等標本試驗比例，量化它副韌帶與關節面在不同方向的分擔"}],"neumann.ch12.bone-architecture":[{"to":"nordin.ch08.trabecular-bone","book":"生物力學","title":"生物力學第8章 · 骨小梁與皮質共同決定承載能力","