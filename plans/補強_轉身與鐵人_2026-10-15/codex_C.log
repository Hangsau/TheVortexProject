+    for step in steps:
+        fn = checks.get(step)
+        if not fn:
+            sys.exit("用法：check.py [P4|L1|L3–L5|V2–V7|T1–T4|W1|W3–W8]；無參數跑全部 W")
+        previous = len(FAILS)
+        fn()
+        failures = FAILS[previous:]
+        if failures:
+            print(f"FAIL {step}（{len(failures)} 項）")
+            for m in failures[:60]:
+                print(" -", m)
+        else:
+            print(f"PASS {step}")
+    sys.exit(1 if FAILS else 0)
