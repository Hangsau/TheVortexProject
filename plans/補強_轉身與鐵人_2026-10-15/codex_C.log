      {{- $recs := slice -}}{{- range $it := $items -}}{{- with index $units $it.uid -}}{{- $recs = $recs | append .record -}}{{- end -}}{{- end -}}
      {{- $rows := dict -}}
      {{- range $ax := $axes -}}
