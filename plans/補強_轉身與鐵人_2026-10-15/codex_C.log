        return
    rng = random.Random(7)
    by_type = {}
    for uid, u in d["units"].items():
        by_type.setdefault(u["type"], []).append(uid)
    for t, ids in by_type.items():
        for uid in rng.sample(sorted(ids), min(5, len(ids))):
