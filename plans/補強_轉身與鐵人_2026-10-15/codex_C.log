ics/ch14/#tfcc-load","rel":"同一概念","why":"它解釋 TFCC 的解剖與承力比例，補充腕關節尺側結構基礎"}],"neumann.ch14.tarsometatarsal":[{"to":"nordin.ch09.lisfranc","book":"生物力學","title":"生物力學第9章 · Lisfranc區的中央穩定與第一列活動相互配合","path":"library/basic-biomechanics/ch09/#lisfranc","rel":"同一概念","why":"兩邊都描述Lisfranc區中央穩定與第一列活動的配合"},{"to":"nordin.ch09.midtarsal-twist","book":"生物力學","title":"生物力學第9章 · 中足鎖定與前足扭轉，是不同尺度的描述","path":"library/basic-biomechanics/ch09/#midtarsal-twist","rel":"同一概念","why":"兩邊皆談中足鎖定與跗蹠關節活動，需互補"}],"nordin.ch09.lisfranc":[{"to":"neumann.ch14.tarsometatarsal","book":"肌動學","title":"肌動學第14章 · 跗蹠關節讓第一列與中央足列分工","path":"library/kinesiology/ch14/#tarsometatarsal","rel":"同一概念","why":"兩邊都描述Lisfranc區中央穩定與第一列活動的配合"},{"to":"neumann.ch14.rays","book":"肌動學","title":"肌動學第14章 · 五條足列兼有中央穩定與兩側調適","path":"library/kinesiology/ch14/#rays","rel":"同一概念","why":"兩邊都談足列的中央穩定與兩側活動差異，這裡補 Lisfranc 韌帶細節"},{"to":"neumann.ch14.tarsal-landmarks","book":"肌動學","title":"肌動學第14章 · 跟骨、舟骨、楔狀骨與骰骨各提供不同支點","path":"library/kinesiology/ch14/#tarsal-landmarks","rel":"同一概念","why":"兩節皆討論跗蹠關節的中央穩定與足部橫弓排列"},{"to":"neumann.ch14.transverse-arch","book":"肌動學","title":"肌動學第14章 · 遠端跗間關節與橫弓，讓負荷橫向分配","path":"library/kinesiology/ch14/#transverse-arch","rel":"同一概念","why":"兩邊都講中足橫弓穩定與蹠骨排列的承重角色"},{"to":"neumann.ch15.first-ray-mtp","book":"肌動學","title":"肌動學第15章 · 第一跗蹠與蹠趾關節的貢獻","path":"library/kinesiology/ch15/#first-ray-mtp","rel":"數據","why":"它給第一跗蹠關節步態中的角度變化，這裡提供站立後期約10°蹠屈的量化對照"},{"to":"neumann.ch14.foot-map","book":"肌動學","title":"肌動學第14章 · 先把踝與足的活動分成不同尺度","path":"library/kinesiology/ch14/#foot-map","rel":"數據","why":"兩者都講第一跗蹠在站立後期的蹠屈活動，它約5°、這裡約10°，可對照數字差異"}],"neumann.ch07.scaphoid-rocking":[{"to":"nordin.ch14.dart-thrower","book":"生物力學","title":"生物力學第14章 · 橈尺偏與飛鏢路徑，使用不同的合成運動","path":"library/basic-biomechanics/ch14/#dart-thrower","rel":"同一概念","why":"兩邊都描述橈尺偏時舟狀骨因旋轉造成影像長度變化"},{"to":"nordin.ch14.carpal-architecture","book":"生物力學","title":"生物力學第14章 · 腕骨的排列把前臂接到手掌","path":"library/basic-biomechanics/ch14/#carpal-architecture","rel":"同一概念","why":"兩