/#shoulder-synthesis","rel":"應用","why":"肩部內外旋肌群知識對應投球各階段穩定與旋轉肌袖活化"},{"to":"ch02.joint-biomechanics.i04","book":"CSCS","title":"CSCS第2章 · 關節生物力學 Joint Biomechanics · 肩關節","path":"library/essentials-of-strength-training/ch02/#ch02.joint-biomechanics.i04","rel":"應用","why":"它談旋轉肌群對肩穩定的關鍵性，這裡詳述肩內外旋肌群組成與力矩差異"}],"movement.action.shoulder-complex.scapular-retraction":[{"to":"neumann.ch05.scapulothoracic-basics","book":"肌動學","title":"肌動學第5章 · 肩胛胸廓介面與三個基本動作","path":"library/kinesiology/ch05/#scapulothoracic-basics","rel":"同一概念","why":"都說明肩胛胸廓介面與後縮等基本動作定義"},{"to":"nordin.ch12.scapulothoracic","book":"生物力學","title":"生物力學第12章 · 肩胛胸廓連接與肩胛方向","path":"library/basic-biomechanics/ch12/#scapulothoracic","rel":"同一概念","why":"它說明肩胛胸廓介面的活動方向與骨面方位"},{"to":"neumann.ch05.scapular-protraction-retraction","book":"肌動學","title":"肌動學第5章 · 肩胛前引與後縮","path":"library/kinesiology/ch05/#scapular-protraction-retraction","rel":"同一概念","why":"它詳細說明肩胛後縮由中斜方菱形與下斜方協同"}],"neumann.ch09.atlanto-occipital":[{"to":"nordin.ch11.occipital-fit","book":"生物力學","title":"生物力學第11章 · 寰枕關節靠骨面貼合，容許點頭並限制末端活動","path":"library/basic-biomechanics/ch11/#occipital-fit","rel":"同一概念","why":"都描述寰枕關節骨面貼合與屈伸為主、旋轉受限"},{"to":"nordin.ch11.upper-cervical","book":"生物力學","title":"生物力學第11章 · 上頸椎的構造有自己的安排","path":"library/basic-biomechanics/ch11/#upper-cervical","rel":"同一概念","why":"它說明寰枕與寰樞分工及上頸椎複合區的結構差異"}],"nordin.ch11.occipital-fit":[{"to":"neumann.ch09.atlanto-occipital","book":"肌動學","title":"肌動學第9章 · 寰枕關節：頭顱在寰椎上點頭","path":"library/kinesiology/ch09/#atlanto-occipital","rel":"同一概念","why":"都描述寰枕關節骨面貼合與屈伸為主、旋轉受限"},{"to":"neumann.ch09.atlanto-axial","book":"肌動學","title":"肌動學第9章 · 寰樞關節：繞齒突旋轉，也需要韌帶約束","path":"library/kinesiology/ch09/#atlanto-axial","rel":"同一概念","why":"兩邊都在談上頸椎骨面與韌帶如何約束旋轉與屈伸"}],"ch22.injury-types.i08":[{"to":"nordin.ch04.tendinopathy","book":"生物力學","title":"生物力學第4章 · 肌腱病不應直接等同肌腱發炎","path":"library/basic-biomechanics/ch04/#tendinopathy","rel":"同一概念","why":"這裡提肌腱炎與肌腱病變差異，它進一步說明傾向用 tendinopathy 的理由"},{"to":"biceps-tendinopathy","boo