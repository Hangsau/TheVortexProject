,"path":"library/kinesiology/ch11/#breathing-stability","rel":"應用","why":"它說明腹內壓在通氣與軀幹穩定間的協調，補充這裡對腹內壓作為脊椎支撐的訓練應用"}],"neumann.ch15.knee-power-frontal":[{"to":"nordin.ch17.knee-moment","book":"生物力學","title":"生物力學第17章 · 膝關節力矩以伸肌力矩為主，並隨負重而變化","path":"library/basic-biomechanics/ch17/#knee-moment","rel":"同一概念","why":"兩邊都談承重期膝伸肌離心控制與站立中期力矩，角度不同但主題同"},{"to":"ch02.joint-biomechanics.i05","book":"CSCS","title":"CSCS第2章 · 關節生物力學 Joint Biomechanics · 膝關節","path":"library/essentials-of-strength-training/ch02/#ch02.joint-biomechanics.i05","rel":"同一概念","why":"兩邊都在講膝關節股四頭肌與髕骨的力臂機制，它為原理這裡為步態驗證"},{"to":"nordin.ch16.knee-kinetics","book":"生物力學","title":"生物力學第16章 · 膝部外力矩、肌肉與前後滑移互相影響","path":"library/basic-biomechanics/ch16/#knee-kinetics","rel":"同一概念","why":"兩邊都談膝關節矢狀面力矩與肌肉/被動結構共同平衡"},{"to":"movement.muscle.knee-extensors","book":"Vortex","title":"Vortex 動作圖譜 · 膝伸肌群","path":"vortex/movement/#movement.muscle.knee-extensors","rel":"同一概念","why":"它介紹膝伸肌群組成與雙關節特性；這裡給出矢狀面功率曲線中股四頭肌向心離心切換"},{"to":"nordin.ch17.knee-power","book":"生物力學","title":"生物力學第17章 · 膝關節功率在承重與推進前期以吸收為主","path":"library/basic-biomechanics/ch17/#knee-power","rel":"應用","why":"它以承重與擺盪分期量化股四頭肌離心、向心功率轉換，補充這裡的週期百分比敘述"},{"to":"movement.muscle.knee-flexors","book":"Vortex","title":"Vortex 動作圖譜 · 膝屈肌群","path":"vortex/movement/#movement.muscle.knee-flexors","rel":"應用","why":"這裡步態膝關節功率曲線具體呈現它膝屈肌群在擺盪期的離心吸收"}],"nordin.ch17.knee-power":[{"to":"neumann.ch15.hip-flexor-abductor-emg","book":"肌動學","title":"肌動學第15章 · 髖屈肌群與外展肌群","path":"library/kinesiology/ch15/#hip-flexor-abductor-emg","rel":"機制","why":"它講髖屈肌與外展肌的步態活化，這裡講膝關節股四頭肌在承重期的離心與向心功率，互補下肢步態肌肉控制"},{"to":"neumann.ch15.weight-acceptance","book":"肌動學","title":"肌動學第15章 · 承重初期需要控制身體的移動","path":"library/kinesiology/ch15/#weight-acceptance","rel":"機制","why":"它講承重初期離心控制，這裡給股四頭肌功率吸收的量化"},{"to":"neumann.ch15.knee-flexor-emg","book":"肌動學","title":"肌動學第15章 · 膝屈肌群與被動屈曲","path":"library/kinesiology/ch15/#knee-flexor-emg","rel":"機制","why":"它描述膝屈肌與被動屈曲的步態功能，這裡解釋股四頭肌離心吸收與向心生成的功率機制"},{"to":"neumann.ch15.knee-deviations","book":"肌動學","title":"肌動學第15章 · 膝伸不直與擺盪彎不夠會造成不同困難","path":"library/kinesiology/ch15/#knee-deviations","rel":"機制","why":"它講膝屈伸受限的步態代償，這裡講膝關節功率在承重與推進期的吸收與生成"},{"to":"neumann.ch15.knee-extensor-emg","book":"肌動學","title":"肌動學第15章 · 膝伸肌群：股四頭肌的功能分層","path":"library/kinesiology/ch15/#knee-extensor-emg","rel":"同一概念","why":"兩邊都描述股四頭肌在承重期離心吸收、站立中期向心生功率的角色"},{"to":"neumann.ch15.knee-sagittal-torque","book":"肌動學","title":"肌動學第15章 · 膝關節矢狀面力矩：從承重到推進前","path":"library/kinesiology/ch15/#knee-sagittal-torque","rel":"同一概念","why":"這裡以功率生成與吸收對應它矢狀面力矩，量化膝屈伸在承重到推進的變化"},{"to":"neumann.ch16.knee-power","book":"肌動學","title":"肌動學第16章 · 膝在承重與擺盪中交替吸收和產生能量","path":"library/kinesiology/ch16/#knee-power","rel":"同一概念","why":"膝在承重與擺盪期的能量吸收與生成"},{"to":"neumann.ch13.swing-control","book":"肌動學","title":"肌動學第13章 · 腿後肌在擺盪末期可以煞住下肢","path":"library/kinesiology/ch13/#swing-control","rel":"同一概念","why":"它描述腿後肌擺盪末期離心煞車，這裡詳述末期擺盪負功率制動機制。"},{"to":"neumann.ch15.knee-power-frontal","book":"肌動學","title":"肌動學第15章 · 膝關節功率曲線與額狀面、水平面力矩","path":"library/kinesiology/ch15/#knee-power-frontal","rel":"應用","why":"這裡以承重與擺盪分期量化股四頭肌離心、向心功率轉換，補充它的週期百分比敘述"},{"to":"neumann.ch16.knee-muscles","book":"肌動學","title":"肌動學第16章 · 股四頭肌與腿後肌群在膝上分別控制兩個方向","path":"library/kinesiology/ch16/#knee-muscles","rel":"應用","why":"它講肌肉活動時序，這裡講同一肌肉在步態中的功率生成與吸收"},{"to":"ch19.sprint-technique.i04","book":"CSCS","title":"CSCS第19章 · 衝刺技術指導 起跑 / 加速 / 最大速度 · 最大速度衝刺的飛行與支撐期有哪些基本動作？","path":"library/essentials-of-strength-training/ch19/#ch19.sprint-technique.i04","rel":"應用","why":"兩邊都在描述膝部股四頭肌離心吸收後向心伸展的時序與角色"},{"to":"ch02.levers.i07","book":"CSCS","title":"CSCS第2章 · 槓桿系統 Levers · 髕骨的作用","path":"library/essentials-of-strength-training/ch02/#ch02.levers.i07","rel":"應用","why":"它講髕骨維持股四頭肌力臂，這裡給步態中股四頭肌吸收與產生功率的時序"}],"nordin.ch17.moments":[{"to":"neumann.ch15.inverse-dynamics","book":"肌動學","title":"肌動學第15章 · 逆動力學、淨內力矩與關節功率","path":"library/kinesiology/ch15/#inverse-dynamics","rel":"機制","why":"它介紹逆動力學概念與外部力矩，這裡說明淨內力矩在 Nm/kg 標準化下的整合結果"},{"to":"neumann.ch15.gait-measurement","book":"肌動學","title":"肌動學第15章 · 現代步態實驗室量測不同面向的資訊","path":"library/kinesiology/ch15/#gait-measurement","rel":"機制","why":"它講步態實驗室三類量測，這裡解釋運動學與地面反作用力如何整合為關節淨力矩"},{"to":"neumann.ch04.measurement","book":"肌動學","title":"肌動學第4章 · 運動學與動力學的量測分工","path":"library/kinesiology/ch04/#measurement","rel":"機制","why":"它說運動學量測，這裡說逆動力學用運動學與外力估淨力矩，是上下游關係"},{"to":"neumann.ch04.dynamic-analysis","book":"肌動學","title":"肌動學第4章 · 動態逆動力學","path":"library/kinesiology/ch04/#dynamic-analysis","rel":"同一概念","why":"兩邊都在解釋逆動力學如何從運動學與外力推算淨關節內力矩"},{"to":"neumann.ch16.joint-kinetics","book":"肌動學","title":"肌動學第16章 · 淨關節力矩與功率需要一致的方向約定","path":"library/kinesiology/ch16/#joint-kinetics","rel":"同一概念","why":"兩段皆解釋逆動力學求淨關節力矩與功率方向約定"},{"to":"neumann.ch04.clinical-synthesis","book":"肌動學","title":"肌動學第4章 · 把一章力學帶回臨床推理","path":"library/kinesiology/ch04/#clinical-synthesis","rel":"同一概念","why":"靜態平衡與逆動力學求淨內力矩的方法"},{"to":"neumann.ch03.torque-angle","book":"肌動學","title":"肌動學第3章 · 等長力量與內力矩—關節角度曲線","path":"library/kinesiology/ch03/#torque-angle","rel":"同一概念","why":"兩邊都談淨內力矩，這裡說明逆動力學算法，它說明關節角度與內力矩的關係"}],"neumann.ch13.meniscal-injury":[{"to":"nordin.ch07.hoop-transfer","book":"生物力學","title":"生物力學第7章 · 環向纖維把楔形組織的向外擴張接住","path":"library/basic-biomechanics/ch07/#hoop-transfer","rel":"機制","why":"這裡講半月板撕裂與臨床處置，它解釋環向纖維如何承受楔形擴張張力，兩者互補"},{"to":"nordin.ch07.contact-distribution","book":"生物力學","title":"生物力學第7章 · 半月板讓「力經過哪裡」成為關鍵","path":"library/basic-biomechanics/ch07/#contact-distribution","rel":"機制","why":"這裡講半月板撕裂與接觸壓力變化，它細論半月板如何分散股骨到脛骨的局部負荷"}],"neumann.ch05.sc-roll-slide":[{"to":"movement.action.shoulder-complex.scapular-elevation","book":"Vortex","title":"Vortex 動作圖譜 · 肩胛骨上提","path":"vortex/movement/#movement.action.shoulder-complex.scapular-elevation","rel":"機制","why":"它說肩胛上提主要來自胸鎖上提，這裡解釋胸鎖關節凹凸滾滑機制，補它的關節面動作原理"},{"to":"nordin.ch12.acromioclavicular","book":"生物力學","title":"生物力學第12章 · 肩鎖關節與鎖骨的支柱作用","path":"library/basic-biomechanics/ch12/#acromioclavicular","rel":"同一概念","why":"兩邊都講鎖骨遠端關節（胸鎖／肩鎖）的支撐與穩定韌帶"}],"neumann.ch16.ankle-power":[{"to":"nordin.ch17.work-energy","book":"生物力學","title":"生物力學第17章 · 作功需要把功率沿實際時間積分","path":"library/basic-biomechanics/ch17/#work-energy","rel":"同一概念","why":"兩者同談步態中踝關節正負功率與能量產生分配"},{"to":"nordin.ch17.power","book":"生物力學","title":"生物力學第17章 · 關節功率把力矩方向與運動方向接起來","path":"library/basic-biomechanics/ch17/#power","rel":"同一概念","why":"它以功率公式與正負定義支援這裡的踝功率分期描述"},{"to":"nordin.ch17.ankle-moment","book":"生物力學","title":"生物力學第17章 · 踝關節由短暫背屈力矩迅速轉為持續的蹠屈力矩","path":"library/basic-biomechanics/ch17/#ankle-moment","rel":"應用","why":"它量化踝背屈與蹠屈力矩峰值（Nm/kg），補充這裡對負正功率轉換的敘述"},{"to":"ch02.work-power.i03","book":"CSCS","title":"CSCS第2章 · 功與功率 Work & Power · 正功 vs 負功","path":"library/essentials-of-strength-training/ch02/#ch02.work-power.i03","rel":"應用","why":"它定義正功負功概念，這裡以踝關節承重推進說明負功率與正功率的轉換實例"}],"neumann.ch15.muscle-tendon-fiber":[{"to":"movement.muscle.knee-extensors","book":"Vortex","title":"Vortex 動作圖譜 · 膝伸肌群","path":"vortex/movement/#movement.muscle.knee-extensors","rel":"機制","why":"它說明股直肌跨髖膝特性；這裡解釋肌腱與肌纖維長度變化可能不同，補足雙關節肌判讀"},{"to":"nordin.ch17.power","book":"生物力學","title":"生物力學第17章 · 關節功率把力矩方向與運動方向接起來","path":"library/basic-biomechanics/ch17/#power","rel":"同一概念","why":"兩者都解釋關節功率，這裡從肌腱單位長度變化切入，它從力矩乘角速度公式展開"},{"to":"nordin.ch06.contraction-modes","book":"生物力學","title":"生物力學第6章 · 向心、離心與等長要按主動肌肉的長度變化判斷","path":"library/basic-biomechanics/ch06/#contraction-modes","rel":"同一概念","why":"兩邊都談肌腱與肌纖維長度變化不等同"}],"neumann.ch07.grip-length":[{"to":"nordin.ch14.tenodesis","book":"生物力學","title":"生物力學第14章 · 腕部位置可透過被動張力帶動手指","path":"library/basic-biomechanics/ch14/#tenodesis","rel":"機制","why":"這裡以臨床案例說明腕位影響握力，它解釋跨關節外在肌的長度—張力連動機制"},{"to":"movement.muscle.wrist-flexors","book":"Vortex","title":"Vortex 動作圖譜 · 腕屈肌群","path":"vortex/movement/#movement.muscle.wrist-flexors","rel":"機制","why":"這裡解釋腕屈時握力下降的主動長度與被動阻力機制，正是它腕屈肌群受手肘位置影響的力學基礎"},{"to":"nordin.ch14.grip-stability","book":"生物力學","title":"生物力學第14章 · 抓握時，手腕需要維持可用的位置","path":"library/basic-biomechanics/ch14/#grip-stability","rel":"數據","why":