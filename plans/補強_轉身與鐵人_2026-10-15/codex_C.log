          {{- if reflect.IsSlice $v -}}{{- range $v -}}{{- $seen = merge $seen (dict (string .) true) -}}{{- end -}}{{- else if $v -}}{{- $seen = merge $seen (dict (string $v) true) -}}{{- end -}}
        {{- end -}}
        {{- $html := "" -}}
        {{- range $ax.values -}}{{- if index $seen .key -}}{{- $html = printf "%s<button type=\"button\" aria-pressed=\"false\" data-filter=\"%s\" data-value=\"%s\">%s</button>" $html $ax.dim .key .zh -}}{{- end -}}{{- end -}}
        {{- $rows = merge $rows (dict $ax.dim (dict "label" $ax.label "html" $html "primary" $ax.primary)) -}}
      {{- end -}}
