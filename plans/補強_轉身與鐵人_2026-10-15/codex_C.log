+import functools
+import json
+import threading
+from http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer
+from pathlib import Path
+
+import yaml
+from playwright.sync_api import sync_playwright
+
+TASK = Path(__file__).parent
+ROOT = Path('C:/claudehome/projects/my-site')
+UPSTREAM = Path('C:/claudehome/projects/TheVortexProject')
+data = json.loads((ROOT / 'next/data/vortex_links.json').read_text(encoding='utf-8'))
+source = yaml.safe_load((UPSTREAM / 'canonical/instructional/moves.yaml').read_text(encoding='utf-8'))
+strokes = ['free', 'back', 'breast', 'fly', 'udk', 'starts-turns', 'open-water']
+for group in source['strokes']:
+    if group['stroke'] not in ('starts-turns', 'open-water'):
+        continue
+    for move in group['moves']:
+        expected = set(move.get('links', {}).get('drills', []))
+        actual = {e['to'] for e in data['out'][move['id']] if e['rel'] == 'practice'}
+        assert actual == expected, (move['id'], expected, actual)
+print('PASS canonical move drill IDs: starts-turns + open-water')
+
+class QuietHandler(SimpleHTTPRequestHandler):
+    def log_message(self, *_):
+        pass
+
+server = ThreadingHTTPServer(('127.0.0.1', 0), functools.partial(QuietHandler, directory=str(TASK)))
+thread = threading.Thread(target=server.serve_forever, daemon=True)
+thread.start()
+base = f'http://127.0.0.1:{server.server_port}/cortex/'
+print('Static preview:', base)
+errors = []
+try:
+    with sync_playwright() as p:
+        browser = p.chromium.launch(channel='chrome', headless=True)
+        page = browser.new_page(viewport={'width': 1440, 'height': 1000})
+        page.on('pageerror', lambda e: errors.append(str(e)))
+
+        def goto(path):
+            response = page.goto(base + path)
+            assert response.status == 200, (path, response.status)
+
+        goto('vortex/')
+        cards = page.locator('.vh-stroke')
+        assert cards.count() == 7
+        assert [x.split('/')[-2] for x in cards.evaluate_all('(xs) => xs.map(x => x.getAttribute("href"))')] == strokes
+        assert '開放水域與鐵人' in cards.nth(6).inner_text()
+        assert '8 個動作 · 15 個練習 · 0 條誤區' in cards.nth(6).inner_text()
+        cards.nth(6).click()
+        assert page.url.endswith('/vortex/open-water/')
+        assert page.locator('article > h1').inner_text() == '開放水域與鐵人'
+        assert '開放水域沒有牆、沒有池底線' in page.locator('article > .read').inner_text()
+        assert page.locator('.mv-row').count() == 8
+        assert page.locator('.stroke-drills li').count() == 15
+        assert page.locator('.stroke-errors, .stroke-levels').count() == 0
+        assert page.locator('#rail a[href="/cortex/vortex/open-water/"]').inner_text() == '開放水域'
+        for group in ('tech', 'problems'):
+            expected = {u['path'] for u in data['units'].values() if u['stroke'] == 'open-water' and u['type'] == ('tech' if group == 'tech' else 'problem')}
+            hrefs = page.locator('article a').evaluate_all('(xs) => xs.map(x => x.getAttribute("href"))')
+            assert all('/cortex/' + path in hrefs for path in expected)
+        page.screenshot(path=str(TASK / 'open-water-desktop.png'), full_page=True)
+        assert page.evaluate('document.documentElement.scrollWidth <= innerWidth')
+        page.set_viewport_size({'width': 320, 'height': 900})
+        page.reload()
+        assert page.evaluate('document.documentElement.scrollWidth <= innerWidth')
+        page.locator('.stroke-drills summary').click()
+        assert page.locator('.stroke-drills li:visible').count() == 15
+        page.screenshot(path=str(TASK / 'open-water-mobile.png'), full_page=True)
+        print('PASS open-water: full title, premise, 8 moves, 15 drills, 19 tech, 6 problems, navigation, desktop/320px')
+
+        goto('vortex/starts-turns/')
+        assert page.locator('.mv-row').count() == 14
+        assert page.locator('.stroke-drills li').count() == 25
+        for n in range(8, 15):
+            assert page.locator(f'.mv-name[href="/cortex/vortex/moves/starts-turns-{n}/"]').count() == 1
+        for n in range(6, 21):
+            assert page.locator(f'.stroke-drills a[href="/cortex/vortex/drills/st{n}/"]').count() == 1
+        print('PASS starts-turns: 14 moves, 25 drills (including shared Fl30), added moves 8-14 and drills ST6-ST20')
+
+        for section, count in [('drills', 15), ('tech', 19), ('problems', 6), ('moves', 8)]:
+            goto('vortex/' + section + '/')
+            buttons = page.locator('[data-filter="stroke"][data-value]')
+            values = buttons.evaluate_all('(xs) => xs.map(x => x.dataset.value)')
+            assert values[-2:] == ['starts-turns', 'open-water']
+            rows = page.locator('.items > li').evaluate_all('(xs) => xs.map(x => x.dataset.stroke.split(" "))')
+            positions = [min([strokes.index(s) for s in row if s in strokes] or [7]) for row in rows]
+            assert positions == sorted(positions), section
+            page.locator('[data-filter="stroke"][data-value="open-water"]').click()
+            assert page.locator('.items > li:visible').count() == count, section
+            assert page.evaluate('document.documentElement.scrollWidth <= innerWidth'), section
+        print('PASS filters and skill order: drills/tech/problems/moves, 320px')
+
+        goto('')
+        assert page.locator('.bs-v-strokes a').count() == 7
+        assert page.locator('.bs-v-strokes a').last.inner_text() == '開放水域'
+        assert not errors, errors
+        print('PASS bookshelf entry and browser console')
+        browser.close()
+finally:
+    server.shutdown()
+    server.server_close()
