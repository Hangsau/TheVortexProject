ssembly","rel":"機制","why":"這裡描述伸指時序與腕屈肌的長度配合，它解釋伸肌腱膜分支系統如何分送拉力到各指節"},{"to":"nordin.ch14.active-control","book":"生物力學","title":"生物力學第14章 · 外在肌提供拉力，內在肌調整手指配置","path":"library/basic-biomechanics/ch14/#active-control","rel":"機制","why":"這裡說伸指時序中外在與內在肌的配合，它解釋外在肌與內在肌的功能分工"},{"to":"movement.muscle.wrist-flexors","book":"Vortex","title":"Vortex 動作圖譜 · 腕屈肌群","path":"vortex/movement/#movement.muscle.wrist-flexors","rel":"機制","why":"它談腕屈肌跨肘長度變化，這裡說明快速伸指時腕屈肌需抵消伸腕趨勢"},{"to":"nordin.ch14.coupled-fingers","book":"生物力學","title":"生物力學第14章 · PIP 與 DIP 的連動，來自同一套肌腱張力改變","path":"library/basic-biomechanics/ch14/#coupled-fingers","rel":"同一概念","why":"兩邊都談伸指連動，這裡偏時序與外在屈肌回縮，它解釋腱膜分支張力重分配"},{"to":"nordin.ch14.grip-stability","book":"生物力學","title":"生物力學第14章 · 抓握時，手腕需要維持可用的位置","path":"library/basic-biomechanics/ch14/#grip-stability","rel":"應用","why":"它提供手腕位置對抓握表現的量化數據，補充這裡伸指機制"}],"neumann.ch13.patellar-motion":[{"to":"nordin.ch07.patellar-path","book":"生物力學","title":"生物力學第7章 · 髕骨接觸圖的合成範圍，不等於單次動作","path":"library/basic-biomechanics/ch07/#patellar-path","rel":"同一概念","why":"兩邊都講髕骨接觸區隨屈膝向上遷移，它補充接觸圖合成範圍與個體差異限制"},{"to":"nordin.ch07.patellar-tracking","book":"生物力學","title":"生物力學第7章 · 髕骨追蹤要把三維拉力與骨槽一起看","path":"library/basic-biomechanics/ch07/#patellar-tracking","rel":"同一概念","why":"兩邊都講髕骨接觸區隨屈膝改變與三維力線影響追蹤"},{"to":"nordin.ch07.two-articulations","book":"生物力學","title":"生物力學第7章 · 先分清脛股與髕股兩組接觸","path":"library/basic-biomechanics/ch07/#two-articulations","rel":"同一概念","why":"兩邊都區分脛股與髕股關節接觸，提醒不能互換膝關節受力"},{"to":"nordin.ch07.range-measurement","book":"生物力學","title":"生物力學第7章 · 主動、被動與深屈膝末端量到不同條件","path":"library/basic-biomechanics/ch07/#range-measurement","rel":"應用","why":"它補充深屈膝末端軟組織與測量條件差異，呼應這裡對髕骨接觸區隨屈膝改變的描述"}],"nordin.ch07.patellar-path":[{"to":"neumann.ch13.patellar-motion","book":"肌動學","title":"肌動學第13章 · 髕骨的移動與接觸區會一起改變","path":"library/kinesiology/ch13/#patellar-motion","rel":"同一概念","why":"兩邊都講髕骨接觸區隨屈膝向上遷移，這裡補充接觸圖合成範圍與個體差異限制"},{"to":"neumann.ch13.local-tracking","book":"肌動學","title":"肌動學第13章 · 髕骨局部穩定由骨壁與內側軟組織配合","path":"library/kinesiology/ch13/#local-tracking","rel":"同一概念","why":"兩邊都談髕骨接觸面積隨屈膝角度遷移及軟骨負荷分布"},{"to":"neumann.ch13.patellar-anatomy","book":"肌動學","title":"肌動學第13章 · 髕骨把伸肌拉力帶過膝前方","path":"library/kinesiology/ch13/#patellar-anatomy","rel":"同一概念","why":"兩邊都在講髕骨在滑車上的接觸位置與面積變化"}],"nordin.ch06.muscle-scales":[{"to":"ch05.neural-adaptations.i02","book":"CSCS","title":"CSCS第5章 · 神經適應 Neural Adaptations · 大小原則（Size Principle）","path":"library/essentials-of-strength-training/ch05/#ch05.neural-adaptations.i02","rel":"機制","why":"它講大小原則的徵召順序，這裡把它放在肌節到運動單位的結構脈絡"},{"to":"neumann.ch03.muscle-organization","book":"肌動學","title":"肌動學第3章 · 從肌腹到肌節：肌纖維與結締組織的分層","path":"library/kinesiology/ch03/#muscle-organization","rel":"同一概念","why":"它從肌腹到肌節講結構分層，這裡加入運動單位作為神經控制尺度的對照"},{"to":"ch01.neuromuscular.motor-unit","book":"CSCS","title":"CSCS第1章 · 神經肌肉系統 Neuromuscular · 運動單位的定義","path":"library/essentials-of-strength-training/ch01/#ch01.neuromuscular.motor-unit","rel":"同一概念","why":"兩邊都定義運動單位並區分其與解剖肌束的不同分類尺度"},{"to":"neumann.ch03.neural-drive","book":"肌動學","title":"肌動學第3章 · 神經驅動、運動單位與大小原則","path":"library/kinesiology/ch03/#neural-drive","rel":"同一概念","why":"這裡以不同尺度補充運動單位的神經與結構面向"},{"to":"ch01.muscle-structure.perimysium","book":"CSCS","title":"CSCS第1章 · 肌肉結構 Muscle Structure · 肌束膜包住的是什麼","path":"library/essentials-of-strength-training/ch01/#ch01.muscle-structure.perimysium","rel":"同一概念","why":"兩邊都在講肌纖維到整條肌肉的層級結構與結締組織包裹"},{"to":"ch01.muscle-structure.sarcomere","book":"CSCS","title":"CSCS第1章 · 肌肉結構 Muscle Structure · 肌節是什麼，靜息時多長","path":"library/essentials-of-strength-training/ch01/#ch01.muscle-structure.sarcomere","rel":"同一概念","why":"它講肌節結構，這裡把它放到肌纖維與運動單位的更大尺度脈絡"},{"to":"neumann.ch03.length-and-tension","book":"肌動學","title":"肌動學第3章 · 主動長度—張力與滑動肌絲","path":"library/kinesiology/ch03/#length-and-tension","rel":"同一概念","why":"它解釋肌節層級的長度—張力與滑動肌絲，這裡把肌節放到運動單位與肌纖維束的尺度鏈中"},{"to":"neumann.ch03.fiber-types","book":"肌動學","title":"肌動學第3章 · 慢縮、快縮與纖維分類","path":"library/kinesiology/ch03/#fiber-types","rel":"同一概念","why":"兩邊都從結構尺度談運動單位，這裡補充肌節到肌肉層級"},{"to":"ch01.muscle-structure.fiber-dimensions","book":"CSCS","title":"CSCS第1章 · 肌肉結構 Muscle Structure · 一條肌纖維長什麼樣","path":"library/essentials-of-strength-training/ch01/#ch01.muscle-structure.fiber-dimensions","rel":"同一概念","why":"它描述單一肌纖維的結構，這裡將結構由肌節到運動單位完整串接。"}],"neumann.ch10.rotation":[{"to":"free.tech.33","book":"Vortex","title":"Vortex · 螺旋線動力鏈——用跨側肩、軀幹、髖、腳定位連動斷點","path":"vortex/tech/free-tech-33/","rel":"同一概念","why":"這裡腹斜肌跨側旋轉合作正是它螺旋線跨側動力鏈的核心解剖基礎"},{"to":"udk.tech.5","book":"Vortex","title":"Vortex · 核心肌群在踢腿週期中輪替激活","path":"vortex/tech/udk-tech-5/","rel":"應用","why":"這裡詳述腹斜肌與豎脊肌在軀幹旋轉的合作，它將相同肌群對應到游泳踢腿週期的輪替激活"}],"udk.tech.5":[{"to":"neumann.ch10.rotation","book":"肌動學","title":"肌動學第10章 · 轉身的肌肉合作跨過身體中線","path":"library/kinesiology/ch10/#rotation","rel":"應用","why":"它詳述腹斜肌與豎脊肌在軀幹旋轉的合作，這裡將相同肌群對應到游泳踢腿週期的輪替激活"},{"to":"neumann.ch10.abdominal-lines","book":"肌動學","title":"肌動學第10章 · 腹斜肌與腹橫肌，不能只按深淺背功能","path":"library/kinesiology/ch10/#abdominal-lines","rel":"應用","why":"腹斜肌腹橫肌力線對應踢腿週期核心輪替活化"},{"to":"neumann.ch10.stability-scales","book":"肌動學","title":"肌動學第10章 · 節段穩定與整體穩定，是兩個互補尺度","path":"library/kinesiology/ch10/#stability-scales","rel":"應用","why":"核心肌群輪替活化解釋踢腿週期的整體穩定"},{"to":"neumann.ch09.pelvic-load","book":"肌動學","title":"肌動學第9章 · 薦髂韌帶與肌肉，並非全都朝同一方向繃緊","path":"library/kinesiology/ch09/#pelvic-load","rel":"應用","why":"它講薦髂周邊肌肉的力矩方向，這裡說明這些肌肉在踢腿中如何輪替穩定核心。"}],"movement.action.shoulder-complex.external-rotation":[{"to":"neumann.ch05.humeral-external-rotation","book":"肌動學","title":"肌動學第5章 · 肱骨外旋與肩峰下避讓","path":"library/kinesiology/ch05/#humeral-external-rotation","rel":"機制","why":"這裡定義肩外旋水平面動作，它解釋外旋如何讓大結節通過肩峰後方以避免撞擊"},{"to":"neumann.ch05.gh-rotation","book":"肌動學","title":"肌動學第5章 · 屈伸、旋轉與動態中央化","path":"library/kinesiology/ch05/#gh-rotation","rel":"同一概念","why":"它給出肩水平面旋轉的活動範圍數據，補充這裡對外旋動作的定義"}],"neumann.ch08.hand-sensation":[{"to":"nordin.ch14.extensor-assembly","book":"生物力學","title":"生物力學第14章 · 伸肌腱膜把一條拉力分送到不同指節","path":"library/basic-biomechanics/ch14/#extensor-assembly","rel":"機制","why":"它解釋伸肌腱膜如何把一條肌腱的拉力分送到不同指節，補充這裡手部神經支配的動作基礎。"},{"to":"nordin.ch14.sensation-blood","book":"生物力學","title":"生物力學第14章 · 感覺與血流，也是手部操作的條件","path":"library/basic-biomechanics/ch14/#sensation-blood","rel":"同一概念","why":"兩邊都談手部神經分工，這裡偏運動單位大小與分級，它偏感覺皮膚與抓握底座條件"},{"to":"nordin.ch14.active-control","book":"生物力學","title":"生物力學第14章 · 外在肌提供拉力，內在肌調整手指配置","path":"library/basic-biomechanics/ch14/#active-control","rel":"同一概念","why":"兩邊都在區分手外在肌與內在肌的功能分工"},{"to":"ch01.neuromuscular.motor-unit","book":"CSCS","title":"CSCS第1章 · 神經肌肉系統 Neuromuscular · 運動單位的定義","path":"library/essentials-of-strength-training/ch01/#ch01.neuromuscular.motor-unit","rel":"應用","why":"它定義運動單位，這裡以手部精細動作為例說明運動單位大小與分級控制的關係"}],"neumann.ch02.articular-cartilage":[{"to":"nordin.ch03.elastohydrodynamic","book":"生物力學","title":"生物力學第3章 · 可變形表面使潤滑與接觸幾何互相影響","path":"library/basic-biomechanics/ch03/#elastohydrodynamic","rel":"機制","why":"它解釋關節軟骨彈性流體動力潤滑機制，補充這裡軟骨作為低摩擦介面的結構描述"},{"to":"nordin.ch03.depth-zones","book":"生物力學","title":"生物力學第3章 · 表層、中層與深層有不同纖維方向","path":"library/basic-biomechanics/ch03/#depth-zones","rel":"機制","why":"這裡介紹關節軟骨結構，它詳述其表中深層膠原纖維方向與力學功能"},{"to":"nordin.ch03.fluid-load-friction","book":"生物力學","title":"生物力學第3章 · 間質液體分擔負荷，可減少固體摩擦","path":"library/basic-biomechanics/ch03/#fluid-load-friction","rel":"機制","why":"它解釋間質液體支撐如何降低軟骨有效摩擦係數"},{"to":"nordin.ch03.network-interaction","book":"生物力學","title":"生物力學第3章 · 蛋白聚醣溶液不等於完整軟骨","path":"library/basic-biomechanics/ch03/#network-interaction","rel":"機制","why":"這裡介紹關節軟骨結構，它解釋其剪切力學來自成分組成"},{"to":"nordin.ch03.matrix","book":"生物力學","title":"生物力學第3章 · 軟骨由細胞維護一個含水的基質","path":"library/basic-biomechanics/ch03/#matrix","rel":"同一概念","why":"兩邊都介紹關節軟骨的無血管低摩擦特性，它補充基質維護與細胞稀少不代表被動"},{"to":"ch05.connective-tissue.i07","book":"CSCS","title":"CSCS第5章 · 結締組織適應 Bone & Connective Tissue · 軟骨","path":"library/essentials-of-strength-training/ch05/#ch05.connective-tissue.i07","rel":"同一概念","why":"兩邊都在講關節軟骨的無血管特性與活動對其健康的影響"},{"to":"ch01.skeleton.synovial-joint